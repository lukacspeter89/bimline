---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';

const base = import.meta.env.BASE_URL;

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Kötelező energetikai felülvizsgálat 70 kW feletti fűtési rendszerekre',
  serviceType:
    '70 kW feletti effektív névleges teljesítményű fűtési (és kombinált fűtő-szellőző) rendszerek kötelező, rendszeres energetikai felülvizsgálata a helyszíni felméréstől a hatósági lejelentésig',
  provider: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
  },
  areaServed: { '@type': 'Country', name: 'Magyarország' },
  url: new URL('/szolgaltatasok/energetikai-felulvizsgalat/', SITE.url).toString(),
  description:
    'Az energiahatékonysági törvény szerinti kötelező energetikai felülvizsgálat 70 kW feletti fűtési rendszerekre: helyszíni felülvizsgálat, jogszabálynak megfelelő jegyzőkönyv és hatósági lejelentés — átlátható, fix árakon, országosan.',
});

const targets = [
  {
    title: '70 kW feletti rendszerek üzemeltetői',
    desc: 'A kötelezettség a 70 kW összesített effektív névleges teljesítmény feletti fűtési rendszerek üzemeltetőire vonatkozik — ennek hiányában a tulajdonosokra.',
  },
  {
    title: 'Minden épülettípus érintett',
    desc: 'Irodaház, ipari csarnok, társasház, intézmény, kereskedelmi és egészségügyi épület — az épület funkciójától függetlenül.',
  },
  {
    title: '8 évente esedékes',
    desc: 'A felülvizsgálatot 8 évente kell megismételni; energetikai auditra kötelezett cégeknél a kötelező energetikai auditálás alkalmával, annak részeként kell elvégeztetni.',
  },
  {
    title: 'Új rendszernél 1 éven belül',
    desc: 'A 2022. január 1. után üzembe helyezett rendszereknél az üzembe helyezéstől számított 1 éven belül el kell végezni az első felülvizsgálatot.',
  },
  {
    title: 'Mentesülés — szigorú feltételekkel',
    desc: 'Mentesülhet pl. az energiahatékonyság-alapú vagy távhőszolgáltatói rendszerüzemeltetési szerződés alá tartozó, illetve nem lakóépületben a 290 kW feletti, megfelelő épületautomatizálással ellátott rendszer. A mentességet igazolni kell — a feltételeket felmérjük és dokumentáljuk.',
  },
];

const scope = [
  'A hőtermelő berendezések hatásfoka és állapota (kazánok, hőszivattyúk, hőközpontok)',
  'Méretezés-ellenőrzés: a beépített teljesítmény összevetése az épület tényleges fűtési igényével — az üzemeltetői tapasztalat alapján rögzítve',
  'A szabályozás, hőelosztás és szivattyúzás energiahatékonysága',
  'Az üzemeltetési és karbantartási gyakorlat értékelése',
  'Javaslatok: költséghatékony üzemviteli és beruházási intézkedések a fogyasztás csökkentésére',
];

const legal = [
  {
    k: 'Uniós alap',
    v: 'Az épületek energiahatékonyságáról szóló EPBD irányelv (2010/31/EU, módosítva: (EU) 2018/844) — a 70 kW feletti fűtési és légkondicionáló rendszerek kötelező felülvizsgálata.',
  },
  {
    k: 'Magyar szabályozás',
    v: 'Az energiahatékonyságról szóló 2015. évi LVII. törvény és végrehajtási rendeletei — köztük a 666/2020. (XII. 28.) Korm. rendelet, valamint a 19/2021. (IV. 14.) ITM rendelet — a felülvizsgálat tartalma, gyakorisága, a jogosultság és a szankciók.',
  },
  {
    k: 'Mire terjed ki?',
    v: 'A kötelezettség nemcsak a fűtőrendszereket érinti: a) a 70 kW-nál nagyobb effektív névleges teljesítményű fűtési rendszer vagy kombinált helyiségfűtési és szellőzőrendszer, b) a 70 kW-nál nagyobb effektív névleges teljesítményű légkondicionáló rendszer vagy kombinált légkondicionáló és szellőzőrendszer hozzáférhető részeire is rendszeres energetikai felülvizsgálatot kell készíteni.',
  },
  {
    k: 'Ki végezheti?',
    v: 'Kizárólag a Magyar Mérnöki Kamara névjegyzékében szereplő, energetikai felülvizsgálói jogosultsággal rendelkező szakember.',
  },
  {
    k: 'Mentesség',
    v: 'Mentesülhetnek a lakóépületi rendszerek folyamatos elektronikus felügyeleti és hatékony ellenőrző funkciókkal, nem lakóépületben a 290 kW-nál nagyobb rendszerek megfelelő épületautomatizálási és -szabályozási rendszerrel, valamint az energiahatékonyság-alapú szerződés (122/2015. (V. 26.) Korm. rendelet 8. §) vagy a távhőszolgáltatóval kötött rendszerüzemeltetési szerződés hatálya alá tartozó rendszerek. A mentességet a rendszerüzemeltető köteles igazolni; a kérelmet energetikai felülvizsgáló nyújtja be a Magyar Mérnöki Kamarához, amely azt elbírálja.',
  },
  {
    k: 'Ellenőrzés',
    v: 'A kötelezettség teljesítését a Nemzeti Klímavédelmi Hatóság ellenőrzi: nemteljesítés esetén határidő tűzésével felszólít, a határidő eredménytelen elteltét követően bírságot szab ki — akár ismételten is. A felülvizsgálati jelentések szakmai ellenőrzését és a mentességi kérelmek elbírálását a Magyar Mérnöki Kamara végzi.',
  },
  {
    k: 'Lejelentés',
    v: 'A felülvizsgálat eredményét jegyzőkönyvben kell rögzíteni és a hatósági nyilvántartásba (klímagáz adatbázis) fel kell tölteni — ezt is mi intézzük.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Adategyeztetés',
    desc: 'Rövid adatbekérés a berendezésekről (típus, teljesítmény, darabszám), majd közös időpont-egyeztetés.',
  },
  {
    n: '2',
    title: 'Helyszíni felülvizsgálat',
    desc: 'Berendezésenként kb. 30–40 perc, az üzemmenet megzavarása nélkül. Az adatokat saját fejlesztésű digitális audit-szoftverünkben rögzítjük.',
  },
  {
    n: '3',
    title: 'Jegyzőkönyv és lejelentés',
    desc: 'Jogszabálynak megfelelő jegyzőkönyv, hatósági lejelentés, valamint automatikus emlékeztető a következő esedékességről.',
  },
];

const why = [
  {
    title: 'Saját fejlesztésű auditszoftver',
    desc: 'A felülvizsgálatot saját digitális rendszerünkkel végezzük: a helyszínen rögzített adatokból hibamentes, egységes jegyzőkönyv készül — gyorsabban és pontosabban, mint papíron.',
  },
  {
    title: 'Teljes körű ügyintézés',
    desc: 'Nemcsak felmérünk: elkészítjük a jogszabály szerinti jegyzőkönyvet és elvégezzük a hatósági lejelentést is. Önnek egyetlen dolga az időpont és a bejutás biztosítása.',
  },
  {
    title: 'Jogosult mérnök szakértelem',
    desc: 'A felülvizsgálatot a Magyar Mérnöki Kamara névjegyzékében szereplő épületgépész mérnök végzi, sokéves tervezői és energetikai audit tapasztalattal.',
  },
  {
    title: 'Határidő-figyelés díjmentesen',
    desc: 'Rendszerünk nyilvántartja az esedékességeket, és időben jelezzük a következő kötelező felülvizsgálatot — ügyfeleink többé nem csúsznak határidőt, és nem kockáztatnak bírságot.',
  },
];

// A Magyar Mérnöki Kamara 2025. októberi díjajánlása (MMK_Á/483-3/2025.) szerinti sávos
// rendszerdíjak, a KSH éves fogyasztóiár-indexével (+1,7%) indexálva, 5 000 Ft-ra kerekítve.
const priceGroups = [
  {
    group: 'Lakóépületekben',
    rows: [
      { name: 'Fűtési rendszerek', band: '50 lakásszámig', price: '200 000 Ft' },
      { name: '', band: '50 lakásszám felett', price: '330 000 Ft' },
      { name: 'Légkondicionáló rendszerek, hőszivattyúk', band: '50 lakásszámig', price: '330 000 Ft' },
      { name: '', band: '50 lakásszám felett', price: '465 000 Ft' },
    ],
  },
  {
    group: 'Vállalkozásoknál',
    rows: [
      { name: 'Fűtési rendszerek', band: '70 kW felett', price: '200 000 Ft' },
      { name: '', band: '290 kW felett', price: '330 000 Ft' },
      { name: 'Légkondicionáló rendszerek, hőszivattyúk', band: '290 kW teljesítményig', price: '465 000 Ft' },
      { name: '', band: '290 kW felett', price: '595 000 Ft' },
    ],
  },
];

const faq = [
  {
    q: 'Mi számít 70 kW feletti rendszernek?',
    a: 'A 70 kW összesített effektív névleges teljesítmény feletti hőtermelő berendezéssel üzemelő fűtési (és kombinált fűtő-szellőző) rendszerek. A kötelezettség a 70 kW-nál nagyobb teljesítményű légkondicionáló, illetve kombinált légkondicionáló és szellőzőrendszerekre is kiterjed.',
  },
  {
    q: 'Mikorra kellett volna elvégezni? Késésben vagyok?',
    a: 'A 2022 előtt üzembe helyezett rendszerek első felülvizsgálatának határideje 2025. december 31-én lejárt, így aki még nem végeztette el, 2026. január 1. óta mulasztásban van. A Nemzeti Klímavédelmi Hatóság megkezdte a mulasztásban lévő üzemeltetők tájékoztatását és felszólítását; az eljárás lépcsői a felszólítás, a póthatáridő, majd a bírság (kategóriától függően 150 000 – 600 000 Ft, ismételt mulasztás esetén 150%-os emelt összeg). A Hatóság tájékoztatása szerint a soron kívüli elvégeztetés elkerülhetővé teszi a bírságot.',
  },
  {
    q: 'Milyen gyakran kell ismételni?',
    a: 'A felülvizsgálatot 8 évente kell megismételni. Energetikai auditra kötelezett vállalkozásnál a kötelező energetikai auditálás alkalmával, annak részeként kell elvégeztetni. Új rendszernél az üzembe helyezéstől számított 1 éven belül esedékes az első felülvizsgálat. A következő esedékességet rendszerünk díjmentesen figyeli, és időben jelezzük.',
  },
  {
    q: 'Mentesülhetek a kötelezettség alól?',
    a: 'Igen, de a feltételek szigorúak. Lakóépületben mentesülhet a folyamatos elektronikus felügyeleti és hatékony ellenőrző funkciókkal rendelkező rendszer; nem lakóépületben a 290 kW-nál nagyobb, megfelelő épületautomatizálási és -szabályozási rendszerrel ellátott rendszer. Mindkét esetben mentességet adhat az energiahatékonyság-alapú szerződés, illetve a távhőszolgáltatóval kötött rendszerüzemeltetési szerződés is. A mentességet a rendszerüzemeltető köteles igazolni: a kérelmet energetikai felülvizsgáló nyújtja be a Magyar Mérnöki Kamarához, amely elbírálja azt. A feltételek fennállását a helyszínen felmérjük, és a mentességi kérelmet is elkészítjük.',
  },
  {
    q: 'Távhővel ellátott az épületünk — ránk is vonatkozik?',
    a: 'Ha a szekunder oldalt a távhőszolgáltató üzemelteti, és a rendszer a távhőszolgáltatóval kötött rendszerüzemeltetési szerződés hatálya alá tartozik, mentesség kérhető — a kérelmet energetikai felülvizsgáló nyújtja be a Magyar Mérnöki Kamarához. Ha azonban a felhasználási hely tulajdonosa nem kötött üzemeltetési szerződést a távhőszolgáltatóval, a felülvizsgálatot el kell végeztetni, mentesség nem kérhető.',
  },
  {
    q: 'Társasház vagyunk — mi a teendőnk?',
    a: 'Társasházak és lakásszövetkezetek esetén a felülvizsgálat megrendeléséről közgyűlési határozatot kell hozni, a felülvizsgálati jelentésben foglalt ajánlásokat pedig a kézhezvételt követő közgyűlésen ismertetni kell. Az üzemeltetéssel és karbantartással kapcsolatos dokumentumokat a felülvizsgáló rendelkezésére kell bocsátani — a folyamatban végig segítünk.',
  },
  {
    q: 'Mennyi ideig tart, és zavarja-e az üzemet?',
    a: 'A helyszíni felülvizsgálat berendezésenként kb. 30–40 percet vesz igénybe, az üzemmenet megzavarása nélkül — a rendszert nem kell leállítani.',
  },
  {
    q: 'Mit tartalmaz az ár?',
    a: 'Díjszabásunk a Magyar Mérnöki Kamara hivatalos díjajánlását követi, az éves inflációval indexálva. A rendszerdíj a felülvizsgálat teljes szakmai tartalmát magában foglalja: helyszíni felmérés, jogszabálynak megfelelő jegyzőkönyv és hatósági lejelentés. A kiszállást — az MMK-ajánlással összhangban — külön, kilométeralapon számoljuk, de a kalkulátor előre megmutatja; Budapesten belül díjmentes. Rejtett költség nincs. Több rendszer vagy több telephely esetén egyedi, kedvezményes ajánlatot adunk.',
  },
];
---

<BaseLayout
  title="Kötelező energetikai felülvizsgálat 70 kW feletti fűtési rendszerekre — jegyzőkönyv és hatósági lejelentés"
  description="70 kW feletti fűtési rendszerek kötelező energetikai felülvizsgálata: helyszíni felmérés, jogszabálynak megfelelő jegyzőkönyv, hatósági lejelentés. A 2025. december 31-i határidő lejárt — pótolja most, átlátható fix árakon, országosan."
  path="/szolgaltatasok/energetikai-felulvizsgalat/"
>
  <script type="application/ld+json" set:html={serviceSchema} slot="head" is:inline />

  <!-- ============ HERO ============ -->
  <section class="relative pt-16 pb-16 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 blueprint-grid pointer-events-none"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[60rem] h-[60rem] bg-accent/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="relative max-w-8xl mx-auto px-5 lg:px-8 pt-12 lg:pt-20">
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">Energetikai felülvizsgálat · 70 kW felett</p>
        <h1 class="font-display font-bold leading-[1.15] tracking-tight text-[clamp(1.75rem,4vw,2.75rem)]">
          Kötelező energetikai felülvizsgálat
          <span class="block text-accent">70 kW feletti fűtési rendszerekre.</span>
        </h1>
        <p class="mt-6 text-lg text-muted max-w-2xl">
          Az energiahatékonysági törvény alapján minden 70 kW effektív névleges teljesítmény feletti
          hőtermelő berendezéssel üzemelő fűtési (és kombinált fűtő-szellőző) rendszert rendszeres
          energetikai felülvizsgálatnak kell alávetni. A BIMLine Gépész Kft. a helyszíni felméréstől
          a hatósági lejelentésig teljes körűen elvégzi ezt Ön helyett.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#kapcsolat" data-cta="hero" class="px-6 py-3 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition glow-accent">Ajánlatkérés</a>
          <a href="#kalkulator" data-cta="hero-calc" class="px-6 py-3 rounded-xl border border-line hover:border-accent/60 hover:bg-surface transition font-medium">Díjkalkulátor</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HATÁRIDŐ ============ -->
  <section class="py-10 border-t border-line/60">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="card rounded-2xl p-6 lg:p-8 border-red-500/40 flex flex-col sm:flex-row gap-5 sm:items-center" data-reveal>
        <div class="shrink-0 sm:w-40">
          <p class="font-display font-bold text-xl text-red-400 leading-tight">A határidő lejárt!</p>
        </div>
        <p class="text-sm text-muted leading-relaxed">
          A 2022 előtt üzembe helyezett rendszerek első felülvizsgálatának határideje
          <strong class="text-ink">2025. december 31-én lejárt</strong>, és a Nemzeti Klímavédelmi
          Hatóság megkezdte a mulasztásban lévő üzemeltetők felszólítását. Az eljárás lépcsői:
          felszólítás, póthatáridő, majd <strong class="text-ink">bírság</strong> — kategóriától függően
          <strong class="text-ink">150 000 – 600 000 Ft</strong>, ismételt mulasztásnál 150%-os emelt
          összegben, akár ismételten is kiszabva. A Hatóság tájékoztatása szerint a
          <strong class="text-ink">soron kívüli elvégeztetés elkerülhetővé teszi a bírságot</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ KIRE VONATKOZIK ============ -->
  <section class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">Kire vonatkozik</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Üzemeltetőkre és tulajdonosokra — épülettípustól függetlenül.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {targets.map((t) => (
          <article class="card rounded-xl p-6 flex flex-col" data-reveal>
            <h3 class="font-display font-semibold text-lg">{t.title}</h3>
            <p class="text-sm text-muted mt-2 leading-relaxed flex-1">{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MIT VIZSGÁLUNK ============ -->
  <section class="py-16 lg:py-20">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow mb-3">Mit vizsgálunk</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          A hőtermelőtől az üzemeltetési gyakorlatig.
        </h2>
      </div>
      <div class="mt-8 grid sm:grid-cols-2 gap-x-8 gap-y-3" data-reveal>
        {scope.map((s) => (
          <div class="flex items-start gap-3 text-sm text-muted">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-accent shrink-0 mt-0.5"><path d="M20 6L9 17l-5-5"/></svg>
            {s}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ JOGSZABÁLYI HÁTTÉR ============ -->
  <section class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">Jogszabályi háttér röviden</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Uniós irányelvtől a hatósági lejelentésig.
        </h2>
      </div>
      <div class="card rounded-2xl divide-y divide-line/60" data-reveal>
        {legal.map((l) => (
          <div class="grid sm:grid-cols-[11rem_1fr] gap-2 sm:gap-6 px-6 py-5">
            <div class="font-display font-semibold text-sm text-accent">{l.k}</div>
            <p class="text-sm text-muted leading-relaxed">{l.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ÍGY DOLGOZUNK ============ -->
  <section class="py-16 lg:py-20">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">Így dolgozunk</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Három egyszerű lépés — Önnek egyetlen dolga az időpont és a bejutás.
        </h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {steps.map((s) => (
          <article class="card rounded-xl p-6 flex flex-col" data-reveal>
            <div class="w-9 h-9 rounded-full bg-accent/15 text-accent grid place-items-center font-display font-bold mb-4">{s.n}</div>
            <h3 class="font-display font-semibold text-lg leading-snug">{s.title}</h3>
            <p class="text-sm text-muted mt-2 leading-relaxed flex-1">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DÍJKALKULÁTOR + ÁRAZÁS ============ -->
  <section id="kalkulator" class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <div class="mb-8" data-reveal>
