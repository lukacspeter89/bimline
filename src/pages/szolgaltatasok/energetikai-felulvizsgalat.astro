            <span>Kérem a mintajegyzőkönyvet és a minta Energetikai veszteségfeltárást e-mailben.</span>
          </label>

          <label class="flex items-start gap-3 text-sm text-muted">
            <input id="f-gdpr" type="checkbox" name="gdpr" class="accent-accent w-4 h-4 mt-0.5">
            <span>Hozzájárulok adataim kapcsolatfelvétel céljából történő kezeléséhez, az <a href={`${base}adatkezeles/`} class="text-accent hover:text-belimo underline underline-offset-2" target="_blank" rel="noopener noreferrer">Adatkezelési tájékoztatóban</a> foglaltak szerint.</span>
          </label>

          <button type="submit" data-cta="form" class="w-full px-6 py-3.5 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition glow-accent">
            Rögzített ajánlatot kérek
          </button>
          <p class="text-xs text-muted">
            Hamarosan jelentkezünk a pontosításokkal, utána küldjük a rögzített díjú ajánlatot.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ---------------- Analitika: CTA-események (GA4, csak hozzájárulás után létező gtag-gel) ----------------
  function track(action: string, params: Record<string, string | number> = {}) {
    const w = window as any;
    if (typeof w.gtag === 'function') {
      w.gtag('event', action, { page_group: 'energetikai', variant: heroVariant, ...params });
    }
  }
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => {
    el.addEventListener('click', () => track('energetikai_cta_click', { cta: el.dataset.cta || '' }));
  });

  // ---------------- Kampány-változat (C: megtakarítás-kampány) ----------------
  // ?u=megtakaritas vagy utm_campaign, amiben szerepel a "megtakaritas" szó → a hero címe és
  // alcíme a megtakarítás-üzenetre vált. Csak a szöveg cserélődik, a szerkezet és a CTA marad,
  // így nincs layout-ugrás. A megtakarítás-kampány neve a GA4-eseményekbe is bekerül (variant).
  const heroVariant = (() => {
    try {
      const q = new URLSearchParams(window.location.search);
      const u = (q.get('u') || '').toLowerCase();
      const camp = (q.get('utm_campaign') || '').toLowerCase();
      return u === 'megtakaritas' || camp.includes('megtakaritas') ? 'megtakaritas' : 'default';
    } catch { return 'default'; }
  })();
  if (heroVariant === 'megtakaritas') {
    const t = document.getElementById('heroTitle');
    const l = document.getElementById('heroLead');
    if (t) {
      t.textContent = '';
      t.append('Hol folyik el a fűtési ');
      const span = document.createElement('span');
      span.className = 'block text-accent';
      span.textContent = 'és hűtési energiája?';
      t.append(span);
    }
    if (l) {
      l.textContent =
        'Megmutatjuk, hol tudja csökkenteni az energiafelhasználását — számokkal, megtérüléssel. Közben a kötelező felülvizsgálatot is letudjuk.';
    }
  }

  // ---------------- Előszűrő (besorolás) ----------------
  // Lead-pontozás: a válaszok data-score értékeinek összege. Kategóriák a marketingstratégia
  // szerint: A = 12+ (elsődleges), B = 8–11 (másodlagos), C = 8 alatt. Kizáró válasz
  // (magánszemély / 70 kW alatt) esetén nem kérünk ajánlatot — udvarias elirányítás.
  const groups = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.qf-group'));
  const qfResult = document.getElementById('qfResult')!;
  const qfTitle = document.getElementById('qfTitle')!;
  const qfText = document.getElementById('qfText')!;
  const qfCta = document.getElementById('qfCta')!;
  const form = document.getElementById('energetikaForm') as HTMLFormElement;
  let qfSummary = '';
  let qfScore = 0;
  let qfCategory = '';
  let qfState: 'ok' | 'unsure' | 'out' | '' = '';

  function readQualifier() {
    const answers: { key: string; label: string; score: number; disqualify: boolean; unsure: boolean }[] = [];
    let complete = true;
    groups.forEach((g) => {
      const checked = g.querySelector<HTMLInputElement>('input:checked');
      if (!checked) { complete = false; return; }
      answers.push({
        key: g.dataset.key || '',
        label: checked.nextElementSibling?.textContent?.trim() || checked.value,
        score: Number(checked.dataset.score || 0),
        disqualify: checked.dataset.disqualify === '1',
        unsure: checked.dataset.unsure === '1',
      });
    });
    return { answers, complete };
  }

  function evaluate() {
    const { answers, complete } = readQualifier();
    if (!complete) return;

    qfScore = answers.reduce((s, a) => s + a.score, 0);
    qfCategory = qfScore >= 12 ? 'A' : qfScore >= 8 ? 'B' : 'C';
    const out = answers.some((a) => a.disqualify);
    const unsure = answers.some((a) => a.unsure);
    const wantsMap = answers.some((a) => a.key === 'szandek' && a.score > 0) || answers.some((a) => a.key === 'rendszerek' && a.score > 0);

    qfSummary = answers.map((a) => `${a.key}: ${a.label}`).join(' | ') + ` | pont: ${qfScore} (${qfCategory})`;
    qfResult.classList.remove('hidden');

    if (out) {
      qfState = 'out';
      qfTitle.textContent = 'Valószínűleg nem vonatkozik Önre.';
      qfText.textContent =
        'A rendszeres energetikai felülvizsgálati kötelezettség a 70 kW feletti, vállalkozások és intézmények által üzemeltetett rendszerekre vonatkozik. Lakossági, családi házas és 70 kW alatti rendszerekkel nem foglalkozunk. Ha a teljesítményben bizonytalan — több készülék együtt is számít —, válassza a „Nem tudom” lehetőséget, és díjmentesen megnézzük.';
      qfCta.classList.add('hidden');
      qfCta.classList.remove('inline-block');
    } else if (unsure) {
      qfState = 'unsure';
      qfTitle.textContent = 'Díjmentesen besoroljuk.';
      qfText.textContent =
        'Küldje el a gépészeti listát, egy adattábla-fotó leírását vagy a gázszámla nagyságrendjét, és hamarosan megmondjuk, kötelezett-e, és hány rendszerről van szó. Csak utána kérjen ajánlatot.';
      qfCta.textContent = 'Kérem a díjmentes besorolást';
      qfCta.classList.remove('hidden');
      qfCta.classList.add('inline-block');
    } else {
      qfState = 'ok';
      qfTitle.textContent = 'Érintett — a felülvizsgálat kötelező.';
      qfText.textContent = wantsMap
        ? 'A válaszai alapján az Energetikai veszteségfeltárást javasoljuk: a kötelező jegyzőkönyv mellé rangsorolt, megtérüléssel számolt javaslatokat kap — több rendszer vagy telephely esetén portfólió-szinten. Az ajánlatban külön szerepel a két csomag, Ön dönt.'
        : 'A Megfelelőségi felülvizsgálat a helyzetéhez illő: hiánytalan jegyzőkönyv és lejelentés, a kötelező javaslattal. Ha a helyszínen látszik, hogy érdemi megtakarítás van a rendszerben, szólunk — döntés csak utána.';
      qfCta.textContent = 'Rögzített ajánlatot kérek';
      qfCta.classList.remove('hidden');
      qfCta.classList.add('inline-block');
      const sel = form?.querySelector<HTMLSelectElement>('select[name="csomag"]');
      if (sel && sel.value === 'javasoljanak') sel.value = wantsMap ? 'terkep' : 'megfelelosegi';
    }

    track('energetikai_qualified', { state: qfState, score: qfScore, category: qfCategory });
  }

  groups.forEach((g) => g.querySelectorAll('input').forEach((i) => i.addEventListener('change', evaluate)));

  // Mintadokumentum kérése: az űrlap "minta" pipáját bejelöli és odagörget.
  document.querySelectorAll<HTMLElement>('[data-sample]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cb = form?.querySelector<HTMLInputElement>('input[name="minta"]');
      if (cb) cb.checked = true;
      document.getElementById('kapcsolat')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // ---------------- Kapcsolatfelvételi űrlap (meglévő Apps Script végponttal) ----------------
  const FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyRR1x9JmTD7yf3RKcwfWKbBexQSKoKqVDUoEERff8SMd9PQEHomNGXFPYfe42yvCsS/exec';
  const formRenderedAt = Date.now();
  // UTM-paraméterek megőrzése (kampány-szintű CPQL méréshez); csak az oldal betöltésekor olvassuk.
  const utm = (() => {
    try {
      const q = new URLSearchParams(window.location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'u'];
      const found = keys.filter((k) => q.get(k)).map((k) => `${k}=${q.get(k)}`);
      if (found.length) sessionStorage.setItem('bimline_utm', found.join('&'));
      return found.length ? found.join('&') : (sessionStorage.getItem('bimline_utm') || '');
    } catch { return ''; }
  })();

  function setFieldError(el: HTMLElement, msg: string) {
    el.classList.add('border-red-500');
    let err = el.parentElement!.querySelector('.field-error');
    if (!err) {
      err = document.createElement('p');
      err.className = 'field-error text-xs text-red-400 mt-1';
      el.parentElement!.appendChild(err);
    }
    err.textContent = msg;
  }
  function clearFieldError(el: HTMLElement) {
    el.classList.remove('border-red-500');
    const err = el.parentElement!.querySelector('.field-error');
    if (err) err.remove();
  }

  function validate() {
    let ok = true;
    const required: [HTMLInputElement | HTMLTextAreaElement, string][] = [
      [form.nev, 'Kérjük, adja meg a nevét.'],
      [form.ceg, 'Adja meg a cég vagy intézmény nevét.'],
      [form.email, 'Adja meg az e-mail címét.'],
    ];
    required.forEach(([el, msg]) => {
      if (!el.value.trim()) { setFieldError(el, msg); ok = false; }
      else clearFieldError(el);
    });
    if (form.email.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email.value.trim())) {
      setFieldError(form.email, 'Az e-mail cím formátuma nem megfelelő.'); ok = false;
    }
    if (form.telefon.value.trim() && !/^[0-9+()\s/-]{6,}$/.test(form.telefon.value.trim())) {
      setFieldError(form.telefon, 'A telefonszám formátuma nem megfelelő.'); ok = false;
    } else {
      clearFieldError(form.telefon);
    }
    if (form.irsz.value.trim() && !/^[1-9]\d{3}$/.test(form.irsz.value.trim())) {
      setFieldError(form.irsz, 'Négyjegyű magyar irányítószámot adjon meg.'); ok = false;
    } else {
      clearFieldError(form.irsz);
    }
    if (!form.gdpr.checked) {
      const box = form.gdpr.closest('label')!;
      if (!box.querySelector('.field-error')) {
        const err = document.createElement('p');
        err.className = 'field-error text-xs text-red-400 mt-1';
        err.textContent = 'A kapcsolatfelvételhez a hozzájárulás szükséges.';
        box.appendChild(err);
      }
      ok = false;
    } else {
      const e = form.gdpr.closest('label')!.querySelector('.field-error');
      if (e) e.remove();
    }
    return ok;
  }

  // Az extra mezőket (besorolás, pontszám, csomag, irányítószám, minta-kérés) a leírásba
  // csomagoljuk, így a meglévő Apps Script módosítás nélkül működik.
  function composedLeiras() {
    const csomagLabel = (form.csomag as HTMLSelectElement).selectedOptions[0]?.textContent?.trim() || '';
    const parts = [
      '[Energetikai felülvizsgálat — 70 kW felett]',
      'Előminősítés: ' + (qfSummary || 'nem töltötte ki') + (qfState ? ` — állapot: ${qfState}` : ''),
      'Érdeklődés: ' + csomagLabel,
      'Irányítószám: ' + (form.irsz.value.trim() || '—'),
      'Mintadokumentumot kér: ' + (form.minta.checked ? 'igen' : 'nem'),
      'Forrás (UTM): ' + (utm || '—'),
      '',
      form.leiras.value.trim() || '(nem írt leírást)',
    ];
    return parts.join('\n');
  }

  function fieldData() {
    return {
      nev: form.nev.value.trim(),
      ceg: form.ceg.value.trim(),
      email: form.email.value.trim(),
      telefon: form.telefon.value.trim(),
      leiras: composedLeiras(),
      alapok: '',
      linkek: '',
      website: (form.querySelector('input[name="website"]') as HTMLInputElement)?.value || '',
      t: String(Math.round((Date.now() - formRenderedAt) / 1000)),
    };
  }

  function sendMailto() {
    const subject = encodeURIComponent('Energetikai felülvizsgálat ajánlatkérés – ' + (form.ceg.value.trim() || form.nev.value.trim()));
    const body = encodeURIComponent(
      ['Név: ' + form.nev.value.trim(), 'Cég: ' + (form.ceg.value.trim() || '—'),
       'E-mail: ' + form.email.value.trim(), 'Telefon: ' + (form.telefon.value.trim() || '—'),
       '', composedLeiras()].join('\n')
    );
    window.location.href = 'mailto:hello@bimline.hu?subject=' + subject + '&body=' + body;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;
    // Konverziós esemény: a minősített (nem kizárt) leadek külön eseményt kapnak — ez importálható
    // Google Ads konverzióként, hogy CPL helyett CPQL-re lehessen optimalizálni.
    track('energetikai_form_submit', { state: qfState || 'unknown', score: qfScore, category: qfCategory || 'n/a' });
    if (qfState === 'ok' || qfState === 'unsure') {
      track('energetikai_qualified_lead', { score: qfScore, category: qfCategory, csomag: form.csomag.value });
    }

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const orig = btn.textContent;

    if (FORM_ENDPOINT) {
      btn.disabled = true;
      btn.textContent = 'Küldés…';
      try {
        const params = new URLSearchParams(fieldData() as Record<string, string>);
        await fetch(FORM_ENDPOINT, { method: 'POST', mode: 'no-cors', body: params });
        btn.textContent = 'Köszönjük! Hamarosan jelentkezünk.';
        btn.classList.add('bg-belimo');
        form.reset();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = orig;
        sendMailto();
      }
      return;
    }
    sendMailto();
    btn.textContent = 'Levelezőprogram megnyitva — köszönjük!';
    btn.classList.add('bg-belimo');
  });

  form?.querySelectorAll('input, textarea, select').forEach((el) => {
    el.addEventListener('input', () => clearFieldError(el as HTMLElement));
  });
</script>
