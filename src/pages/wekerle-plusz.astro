<script>
  import {
    houseFromAnswers, energy, classOf, CLASSES, suggestions, singleEffects, evaluate, applicable,
    financing, supportRate, EXCLUSIVE, UNCERTAINTY_PP, EP_UNCERTAINTY, MEASURES,
  } from '../lib/wekerle-model.js';

  // ---------------- Analitika (GA4, csak hozzájárulás után létező gtag-gel) ----------------
  function track(action: string, params: Record<string, string | number> = {}) {
    const w = window as any;
    if (typeof w.gtag === 'function') w.gtag('event', action, { page_group: 'wekerle', ...params });
  }

  // Energiacímke-színek A+++ → I (a megszokott zöld → piros skála; a betű mindig ki van írva)
  const CLASS_COLORS: Record<string, string> = {
    'A+++': '#0E7A3A', 'A++': '#1B8E3F', 'A+': '#33A33F', 'A': '#56B947', 'B': '#8CC63F', 'C': '#C6D92B',
    'D': '#F2E21B', 'E': '#F7B718', 'F': '#F18E1C', 'G': '#E8641E', 'H': '#DB3B22', 'I': '#C21F25',
  };
  const ANSWER_LABELS: Record<string, Record<string, string>> = {};
  document.querySelectorAll<HTMLFieldSetElement>('.wz-q').forEach((fs) => {
    const key = fs.dataset.key!;
    ANSWER_LABELS[key] = {};
    fs.querySelectorAll<HTMLButtonElement>('.wz-opt').forEach((b) => {
      ANSWER_LABELS[key][b.dataset.v!] = b.querySelector('span')!.textContent!.trim();
    });
  });
  const QUESTION_LABELS: Record<string, string> = {
    year: 'Építés', area: 'Alapterület', storeys: 'Szintek', wall: 'Fal', wallIns: 'Homlokzati szigetelés',
    atticIns: 'Padlás/tető szigetelés', windows: 'Ablakok', heating: 'Fűtés', hmv: 'Melegvíz',
  };
  const M_LABEL: Record<string, string> = Object.fromEntries(MEASURES.map((m) => [m.id, m.label]));

  const fmtM = (ft: number) => (ft / 1e6).toLocaleString('hu-HU', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const pct = (x: number) => Math.round(x * 100);

  // ---------------- Varázsló ----------------
  const steps = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.wz-q'));
  const answers: Record<string, string> = {};
  let cur = 0;
  const elStep = document.getElementById('wzStep')!;
  const elBar = document.getElementById('wzBar') as HTMLDivElement;
  const elBack = document.getElementById('wzBack') as HTMLButtonElement;
  const wizard = document.getElementById('wizard')!;
  const result = document.getElementById('result')!;
  let started = false;

  function show(i: number) {
    cur = i;
    steps.forEach((s, j) => (s.hidden = j !== i));
    elStep.textContent = `${i + 1} / ${steps.length}`;
    elBar.style.width = `${(i / steps.length) * 100}%`;
    elBack.disabled = i === 0;
    // a tetőtér-kérdés szövege a szintek válaszától függ
    const lg = steps[i].querySelector('legend') as HTMLElement;
    if (lg?.dataset.qalt) lg.textContent = answers.storeys === 'tetoter' ? lg.dataset.qalt : lg.dataset.q!;
    steps[i].querySelectorAll<HTMLButtonElement>('.wz-opt').forEach((b) => {
      const sel = answers[steps[i].dataset.key!] === b.dataset.v;
      b.classList.toggle('border-accent', sel);
      b.classList.toggle('bg-accent/10', sel);
    });
  }

  function next() {
    if (cur < steps.length - 1) { show(cur + 1); return; }
    elBar.style.width = '100%';
    renderResult();
  }

  steps.forEach((fs) => {
    fs.querySelectorAll<HTMLButtonElement>('.wz-opt').forEach((b) => {
      b.addEventListener('click', () => {
        if (!started) { started = true; track('wekerle_calc_start'); }
        answers[fs.dataset.key!] = b.dataset.v!;
        next();
      });
    });
  });
  const areaIn = document.getElementById('wzArea') as HTMLInputElement;
  document.querySelectorAll<HTMLButtonElement>('.wz-chip').forEach((c) => c.addEventListener('click', () => { areaIn.value = c.dataset.v!; }));
  function areaNext() {
    const v = Number(areaIn.value);
    if (!(v >= 30 && v <= 600)) { areaIn.classList.add('border-red-500'); return; }
    areaIn.classList.remove('border-red-500');
    answers.area = String(Math.round(v));
    next();
  }
  document.getElementById('wzAreaNext')!.addEventListener('click', areaNext);
  areaIn.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); areaNext(); } });
  elBack.addEventListener('click', () => { if (cur > 0) show(cur - 1); });
  document.getElementById('restart')!.addEventListener('click', () => {
    result.hidden = true; wizard.hidden = false; show(0);
    wizard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ---------------- Eredmény ----------------
  let lastSummary = '';

  function badge(el: HTMLElement, cls: string) {
    el.textContent = cls;
    el.style.background = CLASS_COLORS[cls];
    el.style.color = ['C', 'D', 'E', 'B'].includes(cls) ? '#1A1A26' : '#FFFFFF';
  }
  function pill(cls: string) {
    const dark = ['C', 'D', 'E', 'B'].includes(cls);
    return `<span class="inline-grid place-items-center min-w-9 h-7 px-1.5 rounded-md font-display font-bold text-sm" style="background:${CLASS_COLORS[cls]};color:${dark ? '#1A1A26' : '#fff'}">${cls}</span>`;
  }
  function savingRange(s: number) {
    return `${Math.max(0, pct(s - UNCERTAINTY_PP))}–${pct(s + UNCERTAINTY_PP)} %`;
  }
  function verdict(s: number) {
    if (s - UNCERTAINTY_PP >= 0.30) return { t: 'Biztosan 30 % felett', c: 'text-belimo border-belimo/50' };
    if (s >= 0.30) return { t: 'Határeset — számítással ellenőrizendő', c: 'text-amber-300 border-amber-300/50' };
    return { t: 'Nem éri el a 30 %-ot', c: 'text-red-400 border-red-400/50' };
  }
  // a finanszírozás (hitel, támogatás, önerő) a középértékből számol, ezért azt is kiírjuk
  function costRange(c: number) { return `kb. ${fmtM(c)} M Ft (${fmtM(c * 0.85)}–${fmtM(c * 1.2)})`; }
  let curCls = 'I';
  function finText(c: number) {
    const f = financing(c, curCls);
    return f.rate ? `${fmtM(f.support)} M Ft (a hitel ${Math.round(f.rate * 100)} %-a)` : 'nem jár (A–C besorolás)';
  }
  function finRows(c: number) {
    const f = financing(c, curCls);
    return `<div class="flex justify-between gap-3"><dt class="text-muted">Hitel (3 %)</dt><dd class="text-right">${fmtM(f.hitel)} M Ft</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-muted">Vissza nem térítendő</dt><dd class="font-semibold text-right text-belimo">${f.rate ? fmtM(f.support) + ' M Ft (' + Math.round(f.rate * 100) + ' %)' : 'nem jár (A–C)'}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-muted">Önerő</dt><dd class="text-right">${fmtM(f.onero)} M Ft</dd></div>`;
  }

  function renderResult() {
    const h = houseFromAnswers(answers);
    const ep0 = energy(h);
    const cls0 = classOf(ep0);
    const ci = CLASSES.indexOf(cls0);
    curCls = cls0;
    wizard.hidden = true;
    result.hidden = false;

    badge(document.getElementById('cls0Badge')!, cls0);
    document.getElementById('ep0Text')!.textContent =
      `kb. ${Math.round(ep0 * (1 - EP_UNCERTAINTY) / 10) * 10}–${Math.round(ep0 * (1 + EP_UNCERTAINTY) / 10) * 10} kWh/m²·év összesített energetikai jellemző`;
    document.getElementById('cls0Text')!.textContent =
      ci >= CLASSES.indexOf('G') ? `Az általunk tanúsított házak 87 %-a is G, H vagy I besorolásból indult.`
        : ci >= CLASSES.indexOf('D') ? 'Átlagosnál jobb állapot — a 30 % eléréséhez célzott beavatkozás kell.'
          : 'Már most jó állapot — itt a 30 % nehezebben érhető el.';
    const scale = document.getElementById('scale')!;
    scale.innerHTML = CLASSES.map((c) =>
      `<div class="h-7 grid place-items-center text-[11px] font-display font-bold rounded-[3px] ${c === cls0 ? 'ring-2 ring-ink' : 'opacity-70'}" style="background:${CLASS_COLORS[c]};color:${['C', 'D', 'E', 'B'].includes(c) ? '#1A1A26' : '#fff'}">${c}</div>`).join('');

    const hint = document.getElementById('supportHint')!;
    const rate0 = supportRate(cls0);
    const rLo = supportRate(classOf(ep0 * (1 - EP_UNCERTAINTY))), rHi = supportRate(classOf(ep0 * (1 + EP_UNCERTAINTY)));
    hint.textContent = (rate0 === 0.5
      ? 'A bejelentés szerint H–I besorolásnál a hitelösszeg 50 %-a vissza nem térítendő — a becslés szerint a te házad ebbe a körbe tartozik.'
      : rate0 === 0.3
        ? 'A bejelentés szerint D–G besorolásnál a hitelösszeg 30 %-a vissza nem térítendő — a becslés szerint a te házad ebbe a körbe tartozik.'
        : 'A bejelentés szerint A–C besorolásnál nem jár vissza nem térítendő támogatás, csak a kedvezményes hitel.')
      + (rLo !== rHi ? ' A becslés a sávhatár közelébe esik, ezért itt a hiteles tanúsítvány dönti el, melyik sávba kerülsz.' : '');

    const warns: string[] = [];
    if (answers.year === 'y2007') warns.push('Az előző programban csak 2007 előtt épült házak pályázhattak (induláskor még 1990 volt a határ). A Wekerle Plusz bejelentésében építési év korlát nem hangzott el; ezt a rendelet dönti el.');
    if (answers.wall === 'valyog') warns.push('Az eredeti felhívásban vályog-, szalma-, fa- vagy könnyűszerkezetes falnál statikai szakvéleményt is be kellett nyújtani.');
    if (ci <= CLASSES.indexOf('C')) warns.push('A házad már most jó állapotú: a 30 % csak nagyobb beavatkozással érhető el, és A–C besorolásnál a bejelentés szerint csak a kedvezményes hitel jár, vissza nem térítendő rész nem. Érdemes hiteles tanúsítvánnyal ellenőrizni a kiindulást.');
    document.getElementById('warnings')!.innerHTML = warns.map((w) => `<span class="block">${w}</span>`).join('');

    // Csomagok
    const sug = suggestions(h);
    const titles: Record<string, [string, string]> = {
      minimum: ['A legolcsóbb út a 30 %-hoz', 'A legkisebb becsült költségű csomag, amelynél a becslés alsó határa is eléri a 30 %-ot.'],
      ajanlott: ['Ajánlott', 'Legalább 50 % megtakarítás a legkisebb költségből — a támogatást is jobban kihasználja.'],
      teljes: ['Teljes felújítás', 'Minden beavatkozás, aminek a házadnál értelme van.'],
    };
    const pk = document.getElementById('packages')!;
    if (!sug.length) {
      pk.innerHTML = `<div class="lg:col-span-3 rounded-xl border border-line p-5 text-sm text-muted">A megadott adatok alapján nem találtunk olyan csomagot, amely biztosan elérné a 30 %-ot. Ilyenkor a hiteles tanúsítvány és egy részletes számítás mutatja meg, mi a lehetséges út.</div>`;
    } else {
      pk.innerHTML = sug.map((p: any) => {
        const v = verdict(p.saving);
        const hpNoIns = p.set.includes('hoszivattyu') && !p.set.includes('homlokzat') && !p.set.includes('padlas') && h.wallIns < 0.08;
        return `<article class="rounded-2xl border ${p.kind === 'ajanlott' ? 'border-accent glow-soft' : 'border-line'} bg-surface p-5 flex flex-col">
          <p class="eyebrow">${titles[p.kind][0]}</p>
          <p class="text-xs text-muted mt-1">${titles[p.kind][1]}</p>
          <ul class="mt-4 space-y-1.5 text-sm">${p.set.map((m: string) => `<li class="flex gap-2"><span class="text-accent">✓</span><span>${M_LABEL[m]}</span></li>`).join('')}</ul>
          <dl class="mt-5 space-y-2 text-sm flex-1">
            <div class="flex justify-between gap-3"><dt class="text-muted">Megtakarítás</dt><dd class="text-right"><span class="font-semibold">kb. ${pct(p.saving)} %</span> <span class="text-muted text-xs">(${savingRange(p.saving)})</span></dd></div>
            <div class="flex justify-between gap-3 items-center"><dt class="text-muted">Besorolás</dt><dd>${pill(p.cls0)} → ${pill(p.cls1)}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-muted">Becsült költség</dt><dd class="font-semibold text-right">${costRange(p.cost)}</dd></div>
            ${finRows(p.cost)}
          </dl>
          <p class="mt-4 inline-block self-start text-xs border rounded-full px-2.5 py-1 ${v.c}">${v.t}</p>
          ${hpNoIns ? '<p class="mt-3 text-xs text-amber-300/90">Szigeteletlen házban a hőszivattyút nagyobbra kell méretezni, és a radiátorok cseréje is szükséges lehet — mi ilyenkor a hőszigeteléssel együtt javasoljuk.</p>' : ''}
        </article>`;
      }).join('');
    }

    // Egyenkénti hatás
    const singles = singleEffects(h);
    const maxS = Math.max(0.35, ...singles.map((s: any) => s.saving));
    document.getElementById('singles')!.innerHTML = singles.map((s: any) => `
      <div title="${M_LABEL[s.set[0]]}: kb. ${pct(s.saving)} %, ${costRange(s.cost)}">
        <div class="flex justify-between gap-3 text-sm"><span>${M_LABEL[s.set[0]]}</span><span class="text-muted whitespace-nowrap">kb. ${pct(s.saving)} % · ${costRange(s.cost)}</span></div>
        <div class="relative mt-1 h-2.5 rounded-full bg-line/50">
          <div class="h-2.5 rounded-[4px] bg-accent" style="width:${Math.max(1, (s.saving / maxS) * 100)}%"></div>
          <div class="absolute -top-1 -bottom-1 border-l-2 border-dashed border-ink/60" style="left:${(0.30 / maxS) * 100}%"></div>
        </div>
      </div>`).join('');

    // Saját összeállítás
    const app = applicable(h);
    const builder = document.getElementById('builder')!;
    const preset = new Set<string>(sug[0]?.set || []);
    builder.innerHTML = MEASURES.filter((m) => app.includes(m.id)).map((m) => `
      <label class="flex items-start gap-3 rounded-xl border border-line bg-base/60 px-4 py-3 cursor-pointer hover:border-accent transition">
        <input type="checkbox" value="${m.id}" class="accent-accent w-4 h-4 mt-0.5" ${preset.has(m.id) ? 'checked' : ''}>
        <span><span class="block text-sm font-semibold">${m.label}</span>${m.note ? `<span class="block text-xs text-muted mt-0.5">${m.note}</span>` : ''}</span>
      </label>`).join('');
    const boxes = Array.from(builder.querySelectorAll<HTMLInputElement>('input'));
    boxes.forEach((b) => b.addEventListener('change', () => {
      // egymást kizáró elemek (a hőszivattyú tartalmazza a melegvizet és a szabályozást; klíma és hőszivattyú nem együtt)
      if (b.checked) boxes.forEach((x) => { if ((EXCLUSIVE[b.value] || []).includes(x.value)) x.checked = false; });
      renderBuilder();
    }));
    function renderBuilder() {
      const set = new Set(boxes.filter((x) => x.checked).map((x) => x.value));
      const out = document.getElementById('builderOut')!;
      if (!set.size) { out.innerHTML = '<p class="text-sm text-muted">Válassz legalább egy beavatkozást.</p>'; builderSummary = ''; return; }
      const p: any = evaluate(h, set);
      const v = verdict(p.saving);
      out.innerHTML = `<div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <span><span class="text-muted">Megtakarítás:</span> <strong>kb. ${pct(p.saving)} %</strong> <span class="text-muted text-xs">(${savingRange(p.saving)})</span></span>
        <span class="flex items-center gap-2"><span class="text-muted">Besorolás:</span> ${pill(p.cls0)} → ${pill(p.cls1)}</span>
        <span><span class="text-muted">Költség:</span> <strong>${costRange(p.cost)}</strong></span>
        <span><span class="text-muted">Vissza nem térítendő:</span> <strong class="text-belimo">${finText(p.cost)}</strong></span>
        <span class="text-xs border rounded-full px-2.5 py-1 ${v.c}">${v.t}</span></div>`;
      builderSummary = `Saját összeállítás: ${[...set].map((m) => M_LABEL[m]).join(' + ')} — kb. ${pct(p.saving)} % (${savingRange(p.saving)}), ${p.cls0} → ${p.cls1}, ${costRange(p.cost)}, vissza nem térítendő ${finText(p.cost)}`;
    }
    renderBuilder();

    // Összefoglaló az e-mailhez
    const ans = Object.keys(QUESTION_LABELS).map((k) => `${QUESTION_LABELS[k]}: ${k === 'area' ? answers.area + ' m²' : (ANSWER_LABELS[k]?.[answers[k]] || answers[k] || '—')}`).join(' | ');
    lastSummary = [
      `Válaszok: ${ans}`,
      `Becsült kiinduló állapot: ${cls0} (kb. ${Math.round(ep0)} kWh/m²év)`,
      'Javasolt csomagok:',
      ...sug.map((p: any) => `- ${titles[p.kind][0]}: ${p.set.map((m: string) => M_LABEL[m]).join(' + ')} — kb. ${pct(p.saving)} % (${savingRange(p.saving)}), ${p.cls0} → ${p.cls1}, ${costRange(p.cost)}, vissza nem térítendő ${finText(p.cost)}`),
    ].join('\n');

    document.getElementById('kEyebrow')!.textContent = 'Eredmény elküldése';
    document.getElementById('kTitle')!.textContent = 'Küldd el nekünk az eredményt';
    document.getElementById('kLead')!.textContent = 'A válaszaidat és a kalkuláció eredményét a ház címével együtt átnézzük. Az összefoglalót e-mailben te is megkapod.';
    document.getElementById('kCimOpt')!.hidden = true;
    (document.querySelector('#wekerleForm button[type="submit"]') as HTMLButtonElement).textContent = 'Eredmény elküldése';
    track('wekerle_calc_complete', { cls0, min_saving: sug[0] ? pct(sug[0].saving) : 0, min_cost_m: sug[0] ? Math.round(sug[0].cost / 1e5) / 10 : 0 });
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  let builderSummary = '';

  // ---------------- Űrlap (meglévő Apps Script végpont) ----------------
  const FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyRR1x9JmTD7yf3RKcwfWKbBexQSKoKqVDUoEERff8SMd9PQEHomNGXFPYfe42yvCsS/exec';
  const renderedAt = Date.now();
  const form = document.getElementById('wekerleForm') as HTMLFormElement;
  const utm = (() => {
    try {
      const q = new URLSearchParams(window.location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];
      const found = keys.filter((k) => q.get(k)).map((k) => `${k}=${q.get(k)}`);
      if (found.length) sessionStorage.setItem('bimline_utm', found.join('&'));
      return found.length ? found.join('&') : (sessionStorage.getItem('bimline_utm') || '');
    } catch { return ''; }
  })();

  function fieldErr(el: HTMLElement, msg: string | null) {
    const wrap = el.closest('label') && el.getAttribute('type') === 'checkbox' ? el.closest('label')! : el.parentElement!;
    let err = wrap.querySelector('.field-error');
    if (!msg) { el.classList.remove('border-red-500'); err?.remove(); return true; }
    el.classList.add('border-red-500');
    if (!err) { err = document.createElement('p'); err.className = 'field-error text-xs text-red-400 mt-1'; wrap.appendChild(err); }
    err.textContent = msg;
    return false;
  }
  function partialAnswers() {
    const keys = Object.keys(QUESTION_LABELS).filter((k) => answers[k]);
    if (!keys.length) return '';
    return 'Részben kitöltött kalkulátor — válaszok: ' + keys.map((k) => `${QUESTION_LABELS[k]}: ${k === 'area' ? answers.area + ' m²' : (ANSWER_LABELS[k]?.[answers[k]] || answers[k])}`).join(' | ');
  }
  function composed() {
    return [
      lastSummary ? '[Wekerle Plusz kalkulátor]' : '[Wekerle Plusz — értesítés kérés]',
      'A ház címe: ' + (form.cim.value.trim() || '—'),
      'Értesítést kér az igénylés indulásáról: ' + (form.ertesites.checked ? 'igen' : 'nem'),
      'Forrás (UTM): ' + (utm || '—'),
      'Építészeti dokumentáció: alaprajzok: ' + (form.doc_alaprajz.checked ? 'van' : 'nincs') + ' | metszetek: ' + (form.doc_metszet.checked ? 'van' : 'nincs') + ' | rétegrendek: ' + (form.doc_retegrend.checked ? 'van' : 'nincs'),
      '',
      lastSummary || ('A kalkulátort nem töltötte ki végig.' + (partialAnswers() ? '\n' + partialAnswers() : '')),
      lastSummary ? builderSummary : '',
    ].filter((x) => x !== undefined).join('\n');
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const em = form.email.value.trim();
    let ok = true;
    ok = fieldErr(form.nev, form.nev.value.trim() ? null : 'Add meg a neved.') && ok;
    ok = fieldErr(form.email, !em ? 'Add meg az e-mail címed.' : (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em) ? null : 'Az e-mail cím formátuma nem megfelelő.')) && ok;
    ok = fieldErr(form.cim, (!lastSummary || form.cim.value.trim().length >= 6) ? null : 'Add meg a ház címét.') && ok;
    ok = fieldErr(form.gdpr, form.gdpr.checked ? null : 'Az elküldéshez a hozzájárulás szükséges.') && ok;
    if (!ok) return;

    track('wekerle_form_submit', { with_result: lastSummary ? 1 : 0, notify: form.ertesites.checked ? 1 : 0 });
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Küldés…';
    const data: Record<string, string> = {
      nev: form.nev.value.trim(), ceg: '', email: em, telefon: '', leiras: composed(), alapok: '', linkek: '',
      website: (form.querySelector('input[name="website"]') as HTMLInputElement)?.value || '',
      t: String(Math.round((Date.now() - renderedAt) / 1000)),
    };
    try {
      await fetch(FORM_ENDPOINT, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(data) });
      btn.textContent = 'Köszönjük! Megkaptuk, hamarosan jelentkezünk.';
      btn.classList.add('bg-belimo');
      form.reset();
    } catch {
      btn.disabled = false;
      btn.textContent = orig;
      const subject = encodeURIComponent('Wekerle Plusz kalkulátor – ' + data.nev);
      const body = encodeURIComponent(`Név: ${data.nev}\nE-mail: ${em}\n\n${data.leiras}`);
      window.location.href = `mailto:hello@bimline.hu?subject=${subject}&body=${body}`;
    }
  });
  form.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => fieldErr(el as HTMLElement, null)));

  show(0);
</script>
