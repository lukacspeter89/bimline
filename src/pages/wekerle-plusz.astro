---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const base = import.meta.env.BASE_URL;

// ---------------------------------------------------------------------------
// Statisztika: a BIMLine által 2024–2025-ben az RRF-REP-10.13.1-24 / KEHOP Plusz
// lakossági Otthonfelújítási Programban általunk készített energetikai tanúsítványok és számítások
// (BL24-0069), házanként a legutolsó energetikai nyilatkozat alapján.
// ---------------------------------------------------------------------------
const STATS = {
  houses: 137,
  medianYear: 1971,
  medianArea: 100,
  ghiShare: 87,         // % — G, H vagy I besorolásból indult
  iShare: 48,           // % — I besorolásból indult
  medianSaving: 47,     // % — a tervezett felújítás medián primerenergia-megtakarítása
  over30: 136,          // ennyi terv érte el a 30 %-ot
  medianClassJump: 2,
  wallUninsulated: 79,  // % — szigeteletlen homlokzat
  measures: [
    { label: 'Hőszigetelés (homlokzat és/vagy padlásfödém)', pct: 87 },
    { label: 'Nyílászárócsere', pct: 62 },
    { label: 'Melegvíz-korszerűsítés', pct: 28 },
    { label: 'Hőszivattyú', pct: 27 },
    { label: 'Kondenzációs gázkazán (2024-ben még támogatható volt)', pct: 27 },
  ],
};
// Kiinduló besorolás eloszlása (db)
const startDist: [string, number][] = [
  ['A–C', 7], ['D', 1], ['E', 5], ['F', 5], ['G', 23], ['H', 30], ['I', 66],
];
const startMax = Math.max(...startDist.map(([, v]) => v));

// Családi házas láb — a 2026. 10. 27-i kormányzati sajtótájékoztató szerint.
const program = [
  { k: 'Legfeljebb 15 millió Ft hitel', v: 'fix 3 %-os kamattal, legfeljebb 15 év futamidőre' },
  { k: '30 vagy 50 % vissza nem térítendő', v: 'a hitelösszegből: D–G besorolásnál 30 %, H–I besorolásnál 50 % (legfeljebb 7,5 M Ft); A–C besorolásnál csak a hitel jár' },
  { k: 'Önerő: a hitel 5 %-a', v: 'legfeljebb 500 ezer Ft — így legfeljebb kb. 15,5 M Ft-os felújítás fér a keretbe' },
  { k: 'Legalább 30 % megtakarítás', v: 'primerenergiában, a felújítás előtti és utáni energetikai tanúsítvánnyal igazolva' },
  { k: 'Kinek?', v: 'családi ház, sorház, ikerház, kisebb épületek egyedi fűtésű lakásai — kor-, családi és lakóhely-feltétel nélkül, az egész országban' },
  { k: 'Indulás: 2027 elején', v: 'a bejelentés szerint február–március körül; a pontos dátumot a kormányrendelet rögzíti' },
];

// Épületgépészeti és épületenergetikai feltételek — a bejelentés szerint.
const conditions = [
  {
    t: 'Mire költhető a keret',
    items: [
      'Hőszigetelés: homlokzat, födém, tető.',
      'Nyílászárók cseréje, árnyékolás.',
      'Hőszivattyú és hatékony split klíma.',
      'Használati melegvíz-rendszer korszerűsítése.',
      'Termosztatikus radiátorszelepek, szabályozás.',
      'Világítás korszerűsítése.',
      'Napelem — a keret legfeljebb 20 %-áig, családi háznál legfeljebb 3 M Ft.',
      'Tervezés, műszaki ellenőrzés, tanácsadás.',
    ],
  },
  {
    t: 'Mire nem',
    items: [
      'Gázkazánra — a kondenzációsra sem. A bejelentés kifejezetten kizárta; helyette hőszivattyú vagy hatékony split klíma támogatható.',
      'A–C besorolású háznál vissza nem térítendő támogatás nem jár, csak a kedvezményes hitel.',
    ],
  },
  {
    t: 'Hogyan igazolod a 30 %-ot',
    items: [
      'Kiinduló hiteles energetikai tanúsítvány a mostani állapotról — ez dönti el a besorolást, és vele a 30 vagy 50 %-os sávot.',
      'Energetikai számítás a tervezett állapotra: melyik beavatkozással lesz meg a legalább 30 % primerenergia-megtakarítás.',
      'Kivitelezés, majd záró tanúsítvány. A vissza nem térítendő részt ezután írják jóvá a hiteltartozásból.',
      'A besorolás a 9/2023. (V. 25.) ÉKM rendelet skálája szerinti (A+++ … I).',
    ],
  },
  {
    t: 'Amit még a rendeletből kell kiolvasni',
    items: [
      'Pontosan hogyan számítják a 30 %-ot — beleszámít-e a napelem termelése.',
      'Lesz-e építési év korlát (az előző programban 2007 volt).',
      'Lesz-e kivitelezői vagy tervezői regisztráció, és hogyan fizetnek a kivitelezőnek.',
      'Mikor nyílik a felület, és meddig lehet igényelni.',
    ],
  },
];

// A kérdőív. Minden kérdésnél van „nem tudom” — a modell ilyenkor az építési
// év szerinti jellemző értékkel számol.
const questions = [
  {
    key: 'year', q: 'Mikor épült a ház?', hint: 'Elég nagyjából — ha bővítették, az eredeti rész évét add meg.',
    options: [
      { v: 'y1945', label: '1945 előtt', sub: 'parasztház, polgári ház' },
      { v: 'y1969', label: '1945 és 1969 között', sub: 'sátortetős kockaház, tömör tégla' },
      { v: 'y1989', label: '1970 és 1989 között', sub: 'Kádár-kocka, B30 blokktégla' },
      { v: 'y2006', label: '1990 és 2006 között', sub: '' },
      { v: 'y2007', label: '2007 után', sub: '' },
    ],
  },
  { key: 'area', q: 'Mekkora a fűtött alapterület?', hint: 'A fűtött helyiségek együtt, m²-ben. A pince, a garázs és a fűtetlen padlás nem számít bele.', type: 'number' },
  {
    key: 'storeys', q: 'Hány szintes a fűtött rész?',
    options: [
      { v: 'fszt', label: 'Földszintes', sub: 'felette hideg padlás' },
      { v: 'tetoter', label: 'Földszint + beépített tetőtér', sub: 'a tető alatt is laknak' },
      { v: 'emeletes', label: 'Kétszintes (emeletes)', sub: 'felette hideg padlás' },
    ],
  },
  {
    key: 'wall', q: 'Miből vannak a külső falak?', hint: 'Ha nem tudod, válaszd a „nem tudom”-ot — az építési év alapján becsülünk.',
    options: [
      { v: 'valyog', label: 'Vályog', sub: 'vastag, régi falusi ház' },
      { v: 'tegla_regi', label: 'Tömör tégla', sub: 'régi, kisméretű vagy nagyméretű tégla' },
      { v: 'b30', label: 'Blokktégla (B30)', sub: 'a hetvenes-nyolcvanas évek tipikus fala' },
      { v: 'gazszilikat', label: 'Gázszilikát (Ytong)', sub: 'fehér, könnyű falazóblokk' },
      { v: 'porotherm', label: 'Porotherm vagy hasonló', sub: 'üreges kerámia falazóblokk, 1990 után' },
      { v: 'vegyes', label: 'Kő vagy vegyes falazat', sub: '' },
      { v: 'nemtudom', label: 'Nem tudom', sub: '' },
    ],
  },
  {
    key: 'wallIns', q: 'Van hőszigetelés a homlokzaton?', hint: 'A vakolat alatti „hungarocell” vagy kőzetgyapot. Az ablakok kávájánál vagy a lábazatnál szokott látszani a vastagsága.',
    options: [
      { v: 'nincs', label: 'Nincs', sub: '' },
      { v: 'vekony', label: 'Van, de vékony', sub: 'kb. 5–8 cm' },
      { v: 'vastag', label: 'Van, vastag', sub: '10 cm vagy több' },
      { v: 'nemtudom', label: 'Nem tudom', sub: '' },
    ],
  },
  {
    key: 'atticIns', q: 'Szigetelt a padlásfödém vagy a tető?', qAlt: 'Szigetelt a tetőtér (a ferde tető)?', hint: 'Padlásnál a födém tetején fekvő üveggyapot vagy kőzetgyapot számít.',
    options: [
      { v: 'nincs', label: 'Nincs', sub: '' },
      { v: 'vekony', label: 'Van, de vékony', sub: '10 cm alatt' },
      { v: 'vastag', label: 'Van, vastag', sub: '15 cm vagy több' },
      { v: 'nemtudom', label: 'Nem tudom', sub: '' },
    ],
  },
  {
    key: 'windows', q: 'Milyenek az ablakok?', hint: 'A ház nagyobb részére jellemzőt válaszd.',
    options: [
      { v: 'regi_fa', label: 'Régi fa ablakok', sub: 'kétszárnyú, gerébtokos vagy kapcsolt' },
      { v: 'ketretegu', label: 'Műanyag vagy fa, kétrétegű üveggel', sub: 'a legtöbb, 10–25 éve cserélt ablak' },
      { v: 'haromretegu', label: 'Háromrétegű üvegezés', sub: 'jellemzően az elmúlt 10 évben beépítve' },
      { v: 'nemtudom', label: 'Nem tudom', sub: '' },
    ],
  },
  {
    key: 'heating', q: 'Mivel fűtesz?', hint: 'A fő fűtést válaszd — amivel a ház nagyobb részét fűtöd.',
    options: [
      { v: 'gaz_regi', label: 'Régi gázkazán', sub: 'cirkó vagy állókazán, 10 évnél régebbi' },
      { v: 'gaz_kond', label: 'Kondenzációs gázkazán', sub: 'újabb, műanyag füstcsővel' },
      { v: 'konvektor', label: 'Gázkonvektorok', sub: 'szobánként, falon át kivezetve' },
      { v: 'vegyes', label: 'Vegyes tüzelésű kazán', sub: 'fa, szén, pellet — radiátorokkal' },
      { v: 'kalyha', label: 'Kályha, cserépkályha, kandalló', sub: '' },
      { v: 'villany', label: 'Villanyfűtés', sub: 'hősugárzó, fűtőpanel, villanykazán' },
      { v: 'klima', label: 'Klíma (split)', sub: 'a fő fűtés is klímával megy' },
      { v: 'hoszivattyu', label: 'Hőszivattyú', sub: 'levegő-víz, radiátorokkal vagy padlófűtéssel' },
    ],
  },
  {
    key: 'hmv', q: 'Mivel készül a melegvíz?',
    options: [
      { v: 'futessel', label: 'A fűtéssel együtt', sub: 'kombi kazán, kazán bojlerrel' },
      { v: 'villany', label: 'Villanybojler', sub: '' },
      { v: 'gaz', label: 'Gázbojler vagy átfolyós gázos vízmelegítő', sub: '' },
      { v: 'fa', label: 'Fatüzelésű fürdőhenger', sub: '' },
      { v: 'hoszivattyu', label: 'Hőszivattyú', sub: '' },
    ],
  },
];

// Az eredeti RRF-REP-10.13.1-24 felhívás főbb szabályai (kölcsönkérelmi nyomtatvány és kitöltési útmutató,
// hatályos 2024. 11. 08-tól; kivitelezői regisztrációs felhívás; EU forrású lakossági hitelprogramok
// eljárási rendje, hatályos 2025. 10. 15-től).
const rules = [
  {
    t: 'Melyik ház',
    items: [
      'Lakóház besorolású, szabadon álló vagy sorházi családi ház, illetve ikerház, amelyben életvitelszerűen laknak.',
      'A ház 2007 előtt épült. A program indulásakor még 1990 volt a határ, később emelték 2007-re — hogy a Wekerle Plusznál mennyi lesz, a felhívásból derül ki.',
      'Az ingatlanban kizárólag lakhatási célú energiafelhasználás lehet.',
    ],
  },
  {
    t: 'Mire lehetett költeni',
    items: [
      'A fűtött teret határoló szerkezetek teljes körű hőszigetelése, födémszigetelés.',
      'Nyílászárók cseréje.',
      'Fűtéskorszerűsítés: levegő-víz hőszivattyú, hőleadók cseréje, padló- és mennyezetfűtés, szabályozás.',
      'Melegvíz-rendszer korszerűsítése — önállóan nem, csak más beavatkozással együtt.',
      '2025-től tisztán fosszilis tüzelőberendezés (gázkazán) nem volt támogatható.',
    ],
  },
  {
    t: 'A 30 % igazolása',
    items: [
      'Legalább 30 % primerenergia-megtakarítás a kiinduló állapothoz képest; a kérelemben a 30–40 % és a 40 % feletti sáv közül kellett választani.',
      'A kérelemhez hiteles energetikai tanúsítvány a meglévő állapotról és energetikai számítás a tervezett állapotról, a 9/2023. (V. 25.) ÉKM rendelet szerint.',
      'A munkák végén záró hiteles tanúsítvány. Ha a megtakarítás nem érte el a 30 %-ot, a teljes finanszírozási összeget kamattal visszakövetelhették.',
      'A tanúsítványt nem készítheti az igénylő, a közeli hozzátartozója vagy az ő vállalkozásuk.',
    ],
  },
  {
    t: 'Pénzügyi keretek',
    items: [
      'Futamidő legfeljebb 12 év; a pénz legfeljebb 24 hónapig hívható le, utána 3 hónap türelmi idő, amely alatt az eredményt ellenőrzik.',
      'Önerő legalább 14,3 %; a vissza nem térítendő rész aránya a járástól és az egy főre jutó jövedelemtől függött.',
      'A kivitelezés legfeljebb 24 hónap (indokolt esetben +6 hónap); a kivitelezőnek legalább 2 év jótállást kellett vállalnia.',
      'Az árak nem haladhatták meg a szokásos piaci árat, illetve a felhívás fajlagos egységárait; a tanúsítvány költsége elszámolható volt.',
    ],
  },
];

const faq = [
  {
    q: 'Mennyire pontos ez a becslés?',
    a: `A kalkulátor egy egyszerűsített épületenergetikai modell, amelyet ${STATS.houses} családi ház általunk készített energetikai tanúsítványára és számítására hangoltunk. A kiinduló besorolást a házak 80 %-ánál egy energetikai osztályon belül adta vissza, a felújítás utáni megtakarítást pedig átlagosan inkább óvatosan becsli. Ez irányt ad, de nem helyettesíti a hiteles energetikai tanúsítványt — a támogatáshoz azt kell majd benyújtani.`,
  },
  {
    q: 'Mikor lehet beadni a kérelmet?',
    a: 'A 2026. október 27-i bejelentés szerint a családi házas program 2027 elején, február–március körül indulhat, a társasházi és panelprogram 2027 márciusától. A pontos dátumot és a részletszabályokat a kormányrendelet rögzíti; amint megjelenik, frissítjük az oldalt. Ha kéred, szólunk, amikor indul.',
  },
  {
    q: 'Miért kell energetikai tanúsítvány?',
    a: 'A 30 %-os megtakarítást számítással kell igazolni: egy hiteles tanúsítvány rögzíti a felújítás előtti állapotot, egy tervezett állapotra készült számítás mutatja a megtakarítást, a munkák végén pedig záró tanúsítvány igazolja, hogy a vállalt eredmény megvalósult. A kiinduló besorolás dönti el azt is, mekkora támogatás jár: a bejelentés szerint D–G besorolásnál a hitelösszeg 30 %-a, H–I besorolásnál 50 %-a, A–C besorolásnál nincs vissza nem térítendő rész.',
  },
  {
    q: 'Mi az a 30 %? Ennyivel lesz kisebb a gázszámlám?',
    a: 'Nem pontosan. A 30 % az épület számított, úgynevezett primer energiaigényére vonatkozik, szabványos használati feltételekkel — nem a személyes fogyasztási szokásaidra. A számlád ennél többel vagy kevesebbel is csökkenhet, attól függően, hogyan fűtöttél eddig.',
  },
  {
    q: 'A napelem beleszámít?',
    a: 'Napelemre a bejelentés szerint a keret legfeljebb 20 %-a fordítható, családi háznál legfeljebb 3 millió Ft. Hogy a napelem termelése beleszámít-e a 30 %-ba, még nem tudni: az előző programban a megtakarítást megújuló villamosenergia-termelés nélkül kellett kimutatni, ezért a kalkulátor sem számol vele.',
  },
  {
    q: 'Gázkazán cseréjére jár támogatás?',
    a: 'Nem. A bejelentés szerint a gázkazán — a kondenzációs is — kifejezetten kizárt, ahogy az előző programban is 2025-től. Hőszivattyú és hatékony split klíma viszont támogatható, ahogy a termosztatikus radiátorszelep és a szabályozás is. A kalkulátor ezért gázkazánnal nem számol.',
  },
  {
    q: 'Mi történik, ha a felújítás után nincs meg a 30 %?',
    a: 'Az eredeti felhívásban a munkák végén záró hiteles tanúsítvánnyal kellett igazolni a megtakarítást. Ha ez nem érte el a 30 %-ot, a projekt szabálytalanná vált, és a teljes finanszírozási összeget kamattal együtt visszakövetelhették. A Wekerle Pluszban a vissza nem térítendő részt a záró tanúsítvány után írják jóvá a hitelből, vagyis itt is a záró tanúsítvány dönt. Ezért fontos, hogy a terv ne a határon táncoljon — a kalkulátor is csak olyan csomagot javasol minimumként, amelynek a becslés alsó határa is 30 % felett van.',
  },
  {
    q: 'A hőszivattyú önmagában elég?',
    a: 'Szigeteletlen házban ritkán. A régi radiátorok magas, kb. 70/55 °C-os előremenő hőmérsékletet igényelnek, ezen a hőszivattyú szezonális hatékonysága (SCOP) időjáráskövetéssel is csak 2,3 körül van, ráadásul nagyobb gép kell. Ha a homlokzatot vagy a födémet is szigeteled, a meglévő radiátorok túlméretezetté válnak, elég 55/45 °C vagy kevesebb, és a hatékonyság kb. 2,7-re javul. A kalkulátor ezzel a két értékkel számol — ezért szigeteletlen háznál a hőszivattyút jellemzően a hőszigeteléssel együtt javasolja.',
  },
];
---

<BaseLayout
  title="Wekerle Plusz kalkulátor — mivel éred el a 30 %-os energiamegtakarítást?"
  description="Válaszolj néhány egyszerű kérdésre a házadról, és megmutatjuk a becsült energetikai besorolást, hogy milyen felújítással érhető el a Wekerle Plusz támogatáshoz szükséges 30 %-os megtakarítás, nagyjából mennyibe kerül, és mekkora támogatás járhat rá."
  path="/wekerle-plusz/"
>
  <!-- ============ HERO ============ -->
  <section class="relative pt-16 pb-14 lg:pb-20 overflow-hidden">
    <div class="absolute inset-0 blueprint-grid pointer-events-none"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[60rem] h-[60rem] bg-accent/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="relative max-w-8xl mx-auto px-5 lg:px-8 pt-12 lg:pt-20">
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">Wekerle Plusz · energetikai felújítás · kalkulátor</p>
        <h1 class="font-display font-bold leading-[1.15] tracking-tight text-[clamp(1.75rem,4vw,2.75rem)]">
          Mivel éred el a 30 %-ot?
          <span class="block text-accent">És nagyjából mennyibe kerül?</span>
        </h1>
        <p class="mt-6 text-lg text-muted max-w-2xl">
          Válaszolj kilenc egyszerű kérdésre a házadról. Megmutatjuk, nagyjából milyen energetikai
          besorolásból indulsz, milyen felújítással érhető el a támogatáshoz szükséges 30 %-os
          megtakarítás, mennyibe kerülhet, és mekkora támogatás járhat rá.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#kalkulator" data-cta="hero" class="px-6 py-3 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition glow-accent">Kezdjük — kb. 2 perc</a>
          <a href="#kuldes" data-cta="hero-ertesites" class="px-6 py-3 rounded-xl border border-line text-base font-semibold hover:border-accent transition">Értesítést kérek az indulásról</a>
        </div>
        <p class="mt-5 text-xs text-muted max-w-2xl">
          Nem kell értened az energetikához: ahol nem tudod a választ, jelöld, hogy „nem tudom”.
          A becslés {STATS.houses} családi ház energetikai számítására épül, amelyeket mi készítettünk.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ A PROGRAM ============ -->
  <section class="py-14 lg:py-16 border-t border-line/60 bg-surface/40">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-8" data-reveal>
        <p class="eyebrow mb-3">Amit eddig tudni lehet</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">Wekerle Plusz energetikai felújítás — családi házak</h2>
        <p class="mt-3 text-muted">
          A kormány 2026. október 19-én jelentette be, október 27-én részletezte a programot. Az alábbiak a
          bejelentés főbb pontjai; a végleges szabályokat a kormányrendelet rögzíti.
        </p>
      </div>
