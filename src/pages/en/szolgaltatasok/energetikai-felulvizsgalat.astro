---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../lib/site';

const base = import.meta.env.BASE_URL;

const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Mandatory energy inspection of heating systems above 70 kW',
  serviceType:
    'Mandatory periodic energy inspection of heating (and combined heating-and-ventilation) systems with an effective rated output above 70 kW — from on-site inspection to filing with the authority',
  provider: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
  },
  areaServed: { '@type': 'Country', name: 'Hungary' },
  url: new URL('/en/szolgaltatasok/energetikai-felulvizsgalat/', SITE.url).toString(),
  description:
    'Mandatory energy inspection of heating systems above 70 kW under the Hungarian Energy Efficiency Act: on-site inspection, statutory report and filing with the authority — at transparent fixed prices, across Hungary.',
});

const targets = [
  {
    title: 'Operators of systems above 70 kW',
    desc: 'The obligation applies to operators of heating systems with a combined effective rated output above 70 kW — or, in their absence, to the owners.',
  },
  {
    title: 'Every building type is affected',
    desc: 'Office buildings, industrial halls, residential blocks, institutions, commercial and healthcare buildings — regardless of the building’s function.',
  },
  {
    title: 'Due every 4 or 8 years',
    desc: 'For companies subject to the large-company energy audit obligation the inspection is due every 4 years; otherwise every 8 years.',
  },
  {
    title: 'New systems: within 1 year',
    desc: 'For new systems, the first inspection must be carried out within 1 year of commissioning.',
  },
  {
    title: 'Exemption with building automation',
    desc: 'Operators of a suitable building automation and control system may be exempt — we survey and document this as well.',
  },
];

const scope = [
  'Efficiency and condition of the heat generators (boilers, heat pumps, heating centres)',
  'Sizing check: comparison of the installed capacity with the building’s actual heating demand — recorded on the basis of the operator’s experience',
  'Energy efficiency of the controls, heat distribution and pumping',
  'Assessment of the operation and maintenance practice',
  'Recommendations: cost-effective operational and investment measures to reduce consumption',
];

const legal = [
  {
    k: 'EU basis',
    v: 'The Energy Performance of Buildings Directive (EPBD, 2010/31/EU, as amended by (EU) 2018/844) — mandatory inspection of heating and air-conditioning systems above 70 kW.',
  },
  {
    k: 'Hungarian rules',
    v: 'Act LVII of 2015 on Energy Efficiency and its implementing decrees — including Government Decree 666/2020 (XII. 28.) and ITM Decree 19/2021 (IV. 14.) — content and frequency of the inspection, qualification requirements and sanctions.',
  },
  {
    k: 'What does it cover?',
    v: 'The obligation is not limited to heating systems: periodic energy inspection is required for the accessible parts of a) heating systems or combined space-heating and ventilation systems with an effective rated output above 70 kW, and b) air-conditioning systems or combined air-conditioning and ventilation systems above 70 kW.',
  },
  {
    k: 'Who may carry it out?',
    v: 'Only a professional registered with the Hungarian Chamber of Engineers holding an energy-inspector qualification.',
  },
  {
    k: 'Filing',
    v: 'The result of the inspection must be recorded in a report and uploaded to the official register (the “climate gas” database) — we take care of this too.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Data reconciliation',
    desc: 'A short data request about the equipment (type, capacity, number of units), followed by scheduling a joint appointment.',
  },
  {
    n: '2',
    title: 'On-site inspection',
    desc: 'Approx. 30–40 minutes per unit, without disturbing operation. Data is recorded in our in-house digital audit software.',
  },
  {
    n: '3',
    title: 'Report and filing',
    desc: 'A statutory report, filing with the authority, and an automatic reminder of the next due date.',
  },
];

const why = [
  {
    title: 'In-house audit software',
    desc: 'We carry out the inspection with our own digital system: the data recorded on site produces an error-free, uniform report — faster and more accurately than on paper.',
  },
  {
    title: 'Full administration',
    desc: 'We do not just survey: we prepare the statutory report and complete the filing with the authority as well. Your only task is providing the appointment and site access.',
  },
  {
    title: 'Qualified engineering expertise',
    desc: 'The inspection is carried out by a building services engineer registered with the Hungarian Chamber of Engineers, with many years of design and energy audit experience.',
  },
  {
    title: 'Free deadline tracking',
    desc: 'Our system keeps track of due dates and flags the next mandatory inspection in time — our clients never miss a deadline again and never risk a fine.',
  },
];

const priceTable = {
  cols: ['1 unit', '3 units', '5 units', '10 units'],
  rows: [
    { d: '50 km', v: ['HUF 144,000', 'HUF 264,000', 'HUF 384,000', 'HUF 684,000'] },
    { d: '100 km', v: ['HUF 168,000', 'HUF 288,000', 'HUF 408,000', 'HUF 708,000'] },
    { d: '150 km', v: ['HUF 192,000', 'HUF 312,000', 'HUF 432,000', 'HUF 732,000'] },
  ],
};

const faq = [
  {
    q: 'What counts as a system above 70 kW?',
    a: 'Heating (and combined heating-and-ventilation) systems operating with heat generators whose combined effective rated output exceeds 70 kW. The obligation also extends to air-conditioning and combined air-conditioning and ventilation systems above 70 kW.',
  },
  {
    q: 'When was it due? Are we late?',
    a: 'For systems commissioned before 2022, the deadline for the first inspection expired on 31 December 2025. Those who catch up now can settle their obligation before an official inspection — non-compliance may be fined HUF 150,000–600,000 depending on category, and repeated non-compliance may be fined at a 150% increased rate.',
  },
  {
    q: 'How often must it be repeated?',
    a: 'Every 4 years for companies subject to the large-company energy audit obligation, otherwise every 8 years. For new systems the first inspection is due within 1 year of commissioning. Our system tracks the next due date free of charge, and we notify you in time.',
  },
  {
    q: 'Can we be exempt from the obligation?',
    a: 'Yes: operators of a suitable building automation and control system may be exempt. Whether your system meets the conditions of exemption is something we survey and document on site.',
  },
  {
    q: 'How long does it take, and does it disturb operations?',
    a: 'The on-site inspection takes approx. 30–40 minutes per unit, without disturbing operation — the system does not need to be shut down.',
  },
  {
    q: 'What does the price include?',
    a: 'Prices are indicative net totals excluding VAT, covering the base fee, the fee for additional units and the travel — with no hidden costs. For multiple sites or more than 10 units we provide an individual quote.',
  },
];
---

<BaseLayout
  title="Mandatory energy inspection of heating systems above 70 kW — report and official filing"
  description="Mandatory energy inspection of heating systems above 70 kW in Hungary: on-site inspection, statutory report, filing with the authority. The 31 December 2025 deadline has passed — catch up now, at transparent fixed prices, across Hungary."
  path="/en/szolgaltatasok/energetikai-felulvizsgalat/"
  lang="en"
>
  <script type="application/ld+json" set:html={serviceSchema} slot="head" is:inline />

  <!-- ============ HERO ============ -->
  <section class="relative pt-16 pb-16 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 blueprint-grid pointer-events-none"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[60rem] h-[60rem] bg-accent/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="relative max-w-8xl mx-auto px-5 lg:px-8 pt-12 lg:pt-20">
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">Energy inspection · Above 70 kW</p>
        <h1 class="font-display font-bold leading-[1.15] tracking-tight text-[clamp(1.75rem,4vw,2.75rem)]">
          Mandatory energy inspection
          <span class="block text-accent">of heating systems above 70 kW.</span>
        </h1>
        <p class="mt-6 text-lg text-muted max-w-2xl">
          Under the Hungarian Energy Efficiency Act, every heating (and combined heating-and-ventilation)
          system operating with heat generators above 70 kW effective rated output must undergo a periodic
          energy inspection. BIMLine Gépész Kft. handles the entire process for you — from the on-site
          survey to the filing with the authority.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#kapcsolat" data-cta="hero" class="px-6 py-3 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition glow-accent">Request a quote</a>
          <a href="#kalkulator" data-cta="hero-calc" class="px-6 py-3 rounded-xl border border-line hover:border-accent/60 hover:bg-surface transition font-medium">Fee calculator</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DEADLINE ============ -->
  <section class="py-10 border-t border-line/60">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="card rounded-2xl p-6 lg:p-8 border-red-500/40 flex flex-col sm:flex-row gap-5 sm:items-center" data-reveal>
        <div class="shrink-0 sm:w-44">
          <p class="font-display font-bold text-xl text-red-400 leading-tight">The deadline has passed!</p>
        </div>
        <p class="text-sm text-muted leading-relaxed">
          For systems commissioned before 2022, the deadline for the first inspection expired on
          <strong class="text-ink">31 December 2025</strong>. Non-compliance may be fined
          <strong class="text-ink">HUF 150,000–600,000</strong> depending on category, and repeated
          non-compliance may be fined at a 150% increased rate. Those who catch up now can still settle
          their obligation before an official inspection.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ WHO IS AFFECTED ============ -->
  <section class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">Who is affected</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Operators and owners — regardless of building type.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {targets.map((t) => (
          <article class="card rounded-xl p-6 flex flex-col" data-reveal>
            <h3 class="font-display font-semibold text-lg">{t.title}</h3>
            <p class="text-sm text-muted mt-2 leading-relaxed flex-1">{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE INSPECT ============ -->
  <section class="py-16 lg:py-20">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow mb-3">What we inspect</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          From the heat generator to the operating practice.
        </h2>
      </div>
      <div class="mt-8 grid sm:grid-cols-2 gap-x-8 gap-y-3" data-reveal>
        {scope.map((s) => (
          <div class="flex items-start gap-3 text-sm text-muted">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-accent shrink-0 mt-0.5"><path d="M20 6L9 17l-5-5"/></svg>
            {s}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LEGAL BACKGROUND ============ -->
  <section class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">Legal background in brief</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          From the EU directive to the official filing.
        </h2>
      </div>
      <div class="card rounded-2xl divide-y divide-line/60" data-reveal>
        {legal.map((l) => (
          <div class="grid sm:grid-cols-[11rem_1fr] gap-2 sm:gap-6 px-6 py-5">
            <div class="font-display font-semibold text-sm text-accent">{l.k}</div>
            <p class="text-sm text-muted leading-relaxed">{l.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ HOW WE WORK ============ -->
  <section class="py-16 lg:py-20">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">How we work</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Three simple steps — your only task is the appointment and site access.
        </h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {steps.map((s) => (
          <article class="card rounded-xl p-6 flex flex-col" data-reveal>
            <div class="w-9 h-9 rounded-full bg-accent/15 text-accent grid place-items-center font-display font-bold mb-4">{s.n}</div>
            <h3 class="font-display font-semibold text-lg leading-snug">{s.title}</h3>
            <p class="text-sm text-muted mt-2 leading-relaxed flex-1">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CALCULATOR + PRICING ============ -->
  <section id="kalkulator" class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <div class="mb-8" data-reveal>
        <p class="eyebrow mb-3">Transparent pricing</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Fixed fees with no hidden costs — calculate in advance.
        </h2>
        <p class="mt-3 text-muted">
          The price covers the base fee, the fee for additional units and the travel.
          Departing from Budapest; the travel fee is calculated from the site’s postcode.
        </p>
      </div>

      <div class="card rounded-2xl p-6 lg:p-8" data-reveal>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium mb-2" for="zipInput">Postcode of the site</label>
            <input
              id="zipInput"
              type="text"
              inputmode="numeric"
              maxlength="4"
              placeholder="e.g. 6720"
              class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent"
            />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2" for="devInput">Number of units (1–10)</label>
            <input
              id="devInput"
              type="number"
              min="1"
              max="10"
              value="1"
              class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent"
            />
          </div>
        </div>
        <button id="calcBtn" class="mt-5 px-6 py-3 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition">Calculate</button>
        <p id="calcError" class="hidden text-xs text-red-400 mt-2">Please enter a valid Hungarian postcode (4 digits) and a number of units between 1 and 10.</p>

        <div id="calcResult" class="hidden mt-6 border-t border-line/60 pt-6">
          <dl class="space-y-2.5 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Base fee (includes the inspection of the first unit)</dt>
              <dd class="font-medium whitespace-nowrap" id="rBase"></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Additional units <span id="rDevDetail" class="text-xs"></span></dt>
              <dd class="font-medium whitespace-nowrap" id="rDevices"></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Travel <span id="rKmDetail" class="text-xs"></span></dt>
              <dd class="font-medium whitespace-nowrap" id="rTravel"></dd>
            </div>
          </dl>
          <div class="flex justify-between gap-4 mt-4 pt-4 border-t border-line/60">
            <div class="font-display font-semibold">Indicative total</div>
            <div class="font-display font-bold text-lg text-accent whitespace-nowrap" id="rTotal"></div>
          </div>
          <p class="text-xs text-muted mt-3 leading-relaxed">
            Net, indicative total excluding VAT. The price covers the base fee, the fee for
            additional units and the travel — with no hidden costs. For multiple sites or more
            than 10 units we provide an individual quote. A final, binding offer is sent by e-mail.
          </p>
          <a href="#kapcsolat" id="calcCta" data-cta="calc" class="mt-5 inline-block w-full text-center px-6 py-3.5 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition glow-accent">
            Request a quote for this site
          </a>
        </div>
      </div>

      <!-- Price table -->
      <div class="mt-8" data-reveal>
        <h3 class="font-display font-semibold text-lg mb-4">Indicative prices — by distance and number of units</h3>
        <div class="card rounded-2xl overflow-hidden overflow-x-auto">
          <table class="w-full text-sm min-w-[34rem]">
            <thead>
              <tr class="border-b border-line/60 text-left">
                <th class="px-5 py-3.5 font-display font-semibold">Distance (from Budapest)</th>
                {priceTable.cols.map((c) => (
                  <th class="px-5 py-3.5 font-display font-semibold text-right">{c}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-line/40">
              {priceTable.rows.map((r) => (
                <tr>
                  <td class="px-5 py-3.5 font-medium">{r.d}</td>
                  {r.v.map((v) => (
                    <td class="px-5 py-3.5 text-right text-muted">{v}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-muted mt-3 leading-relaxed">
          Prices are indicative net totals excluding VAT, covering the base fee, the fee for
          additional units and the travel. For multiple sites or more than 10 units we provide
          an individual quote. The offer contains no hidden costs.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ WHY BIMLINE ============ -->
  <section class="py-16 lg:py-20">
    <div class="max-w-8xl mx-auto px-5 lg:px-8">
      <div class="max-w-2xl mb-10" data-reveal>
        <p class="eyebrow mb-3">Why BIMLine</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">
          Digital audit software, full administration.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {why.map((w) => (
          <article class="card rounded-xl p-6 flex flex-col" data-reveal>
            <h3 class="font-display font-semibold text-lg leading-snug">{w.title}</h3>
            <p class="text-sm text-muted mt-2 leading-relaxed flex-1">{w.desc}</p>
          </article>
        ))}
      </div>

      <div class="mt-6 card rounded-xl p-6 lg:p-8" data-reveal>
        <p class="eyebrow mb-3">References</p>
        <p class="text-sm text-muted leading-relaxed">
          Among others: the energy inspection of a 15,000 m² shopping centre, heating modernisation
          of university buildings, and mechanical design of industrial and healthcare facilities.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="py-16 lg:py-20 border-t border-line/60 bg-surface/40">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <div class="mb-8" data-reveal>
        <p class="eyebrow mb-3">Frequently asked questions</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">What operators ask first.</h2>
      </div>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="card rounded-xl px-6 py-4 group" data-reveal>
            <summary class="font-display font-semibold cursor-pointer list-none flex items-center justify-between gap-4">
              {f.q}
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="shrink-0 text-accent transition-transform group-open:rotate-45"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="text-sm text-muted leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="text-xs text-muted mt-6" data-reveal>
        This information does not constitute comprehensive legal advice. Prices are net prices valid in 2026.
      </p>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="kapcsolat" class="py-16 lg:py-24 border-t border-line/60">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <div class="mb-8" data-reveal>
        <p class="eyebrow mb-3">Contact</p>
        <h2 class="font-display font-bold text-[clamp(1.4rem,2.6vw,1.85rem)] leading-tight">Request a quote today</h2>
        <p class="mt-3 text-muted">
          Send us the list of your equipment (type, capacity, location) and we will send an accurate,
          no-obligation quote within 24 hours.
        </p>
      </div>

      <form id="energetikaForm" class="card rounded-2xl p-6 lg:p-8 space-y-5" novalidate data-reveal>
        <div aria-hidden="true" style="position:absolute; left:-9999px; top:-9999px; height:0; overflow:hidden;">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium mb-2">Name</label>
            <input type="text" name="nev" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Company</label>
            <input type="text" name="ceg" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium mb-2">E-mail address</label>
            <input type="email" name="email" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Phone number <span class="text-muted font-normal">(optional)</span></label>
            <input type="tel" name="telefon" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium mb-2">Number of sites</label>
            <input type="number" name="telephelyek" min="1" value="1" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Number of heat-generating units</label>
            <input type="number" name="berendezesek" min="1" value="1" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-2">Equipment list, short description <span class="text-muted font-normal">(type, capacity, location — whatever you know about the system)</span></label>
          <textarea name="leiras" rows="4" class="w-full bg-base border border-line rounded-lg px-4 py-3 text-sm focus:border-accent resize-y"></textarea>
        </div>

        <label class="flex items-start gap-3 text-sm text-muted">
          <input type="checkbox" name="gdpr" class="accent-accent w-4 h-4 mt-0.5">
          <span>I consent to the processing of my data for the purpose of contacting me, as set out in the <a href={`${base}en/adatkezeles/`} class="text-accent hover:text-belimo underline underline-offset-2" target="_blank" rel="noopener noreferrer">Privacy Notice</a>.</span>
        </label>

        <button type="submit" data-cta="form" class="w-full px-6 py-3.5 rounded-xl bg-accent text-base font-semibold hover:bg-accent/90 transition glow-accent">
          Send quote request
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // ---------------- Analytics: CTA events (GA4, gtag only exists after consent) ----------------
  function track(action: string, params: Record<string, string | number> = {}) {
    const w = window as any;
    if (typeof w.gtag === 'function') {
      w.gtag('event', action, { page_group: 'energetikai', ...params });
    }
  }
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => {
    el.addEventListener('click', () => track('energetikai_cta_click', { cta: el.dataset.cta || '' }));
  });

  // ---------------- Fee calculator ----------------
  // Fee items (net HUF) — formula consistent with the flyer's price table:
  //   price = base fee (incl. first unit) + HUF 60,000 × additional unit + travel
  const PRICE_BASE = 120000;       // base fee, incl. inspection of the first unit
  const PRICE_PER_DEVICE = 60000;  // each additional unit
  const PRICE_PER_KM = 480;        // HUF/km, applied to the one-way distance from Budapest
  const MAX_DEVICES = 10;          // above this: individual quote

  // Road distance from Budapest (km, one way) — postcode-prefix based estimate.
  // A 3-digit prefix overrides the 2-digit one, which overrides the 1-digit one.
  const D3: Record<string, number> = {
    '240': 75, '244': 30, '266': 80, '700': 85, '703': 110,
    '823': 130, '830': 160, '836': 190,
  };
  const D2: Record<string, number> = {
    '20': 20, '21': 28, '22': 30, '23': 35, '24': 60, '25': 55, '26': 45, '27': 80, '28': 62, '29': 95,
    '30': 110, '31': 100, '32': 85, '33': 135, '34': 145, '35': 185, '36': 170, '37': 200, '38': 225, '39': 235,
    '40': 230, '41': 230, '42': 215, '43': 280, '44': 235, '45': 280, '46': 260, '47': 290, '48': 305, '49': 320,
    '50': 100, '51': 80, '52': 120, '53': 150, '54': 140, '55': 165, '56': 210, '57': 225,
    '60': 85, '61': 110, '62': 115, '63': 120, '64': 130, '65': 150, '66': 150, '67': 175, '68': 190, '69': 200,
    '70': 85, '71': 150, '72': 160, '73': 190, '74': 190, '75': 230, '76': 200, '77': 210, '78': 230, '79': 220,
    '80': 65, '81': 70, '82': 115, '83': 160, '84': 145, '85': 160, '86': 120, '87': 170, '88': 210, '89': 220,
    '90': 125, '91': 125, '92': 160, '93': 150, '94': 215, '95': 180, '96': 200, '97': 230, '98': 250, '99': 270,
  };
  const D1: Record<string, number> = { '1': 0, '2': 50, '3': 160, '4': 260, '5': 150, '6': 150, '7': 180, '8': 150, '9': 190 };

  function distanceFromZip(zip: string): number | null {
    if (!/^[1-9]\d{3}$/.test(zip)) return null;
    const p3 = zip.slice(0, 3);
    const p2 = zip.slice(0, 2);
    const p1 = zip.slice(0, 1);
    if (p3 in D3) return D3[p3];
    if (p2 in D2) return D2[p2];
    return D1[p1] ?? null;
  }

  const fmt = (n: number) => 'HUF ' + n.toLocaleString('en-GB');

  const zipInput = document.getElementById('zipInput') as HTMLInputElement;
  const devInput = document.getElementById('devInput') as HTMLInputElement;
  const calcBtn = document.getElementById('calcBtn')!;
  const calcError = document.getElementById('calcError')!;
  const calcResult = document.getElementById('calcResult')!;
  let lastCalc = '';

  function runCalc() {
    const zip = zipInput.value.trim();
    const devices = parseInt(devInput.value, 10);
    const km = distanceFromZip(zip);
    if (km === null || !Number.isFinite(devices) || devices < 1 || devices > MAX_DEVICES) {
      calcError.classList.remove('hidden');
      calcResult.classList.add('hidden');
      return;
    }
    calcError.classList.add('hidden');

    const extraDevices = devices - 1;
    const devicesFee = extraDevices * PRICE_PER_DEVICE;
    const travel = km === 0 ? 0 : Math.round((km * PRICE_PER_KM) / 1000) * 1000;
    const total = PRICE_BASE + devicesFee + travel;

    document.getElementById('rBase')!.textContent = fmt(PRICE_BASE);
    document.getElementById('rDevices')!.textContent = extraDevices === 0 ? '—' : fmt(devicesFee);
    document.getElementById('rDevDetail')!.textContent =
      extraDevices === 0 ? '' : `(${extraDevices} × ${fmt(PRICE_PER_DEVICE)})`;
    document.getElementById('rTravel')!.textContent = km === 0 ? 'free of charge' : fmt(travel);
    document.getElementById('rKmDetail')!.textContent =
      km === 0 ? '(within Budapest)' : `(~${km} km)`;
    document.getElementById('rTotal')!.textContent = fmt(total);
    calcResult.classList.remove('hidden');

    lastCalc = `Postcode: ${zip}, units: ${devices} — calculated indicative price: ${fmt(total)} + VAT (base fee ${fmt(PRICE_BASE)}, additional units ${extraDevices === 0 ? '—' : fmt(devicesFee)}, travel ${km === 0 ? 'free of charge' : fmt(travel)})`;
    track('energetikai_calc', { zip, devices, total });
  }

  calcBtn.addEventListener('click', runCalc);
  [zipInput, devInput].forEach((el) =>
    el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); runCalc(); } })
  );

  // ---------------- Contact form (existing Apps Script endpoint) ----------------
  const FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyRR1x9JmTD7yf3RKcwfWKbBexQSKoKqVDUoEERff8SMd9PQEHomNGXFPYfe42yvCsS/exec';
  const form = document.getElementById('energetikaForm') as HTMLFormElement;
  const formRenderedAt = Date.now();

  function setFieldError(el: HTMLElement, msg: string) {
    el.classList.add('border-red-500');
    let err = el.parentElement!.querySelector('.field-error');
    if (!err) {
      err = document.createElement('p');
      err.className = 'field-error text-xs text-red-400 mt-1';
      el.parentElement!.appendChild(err);
    }
    err.textContent = msg;
  }
  function clearFieldError(el: HTMLElement) {
    el.classList.remove('border-red-500');
    const err = el.parentElement!.querySelector('.field-error');
    if (err) err.remove();
  }

  function validate() {
    let ok = true;
    const required: [HTMLInputElement | HTMLTextAreaElement, string][] = [
      [form.nev, 'Please enter your name.'],
      [form.email, 'Please enter your e-mail address.'],
      [form.leiras, 'Please briefly describe the equipment (type, capacity, location).'],
    ];
    required.forEach(([el, msg]) => {
      if (!el.value.trim()) { setFieldError(el, msg); ok = false; }
      else clearFieldError(el);
    });
    if (form.email.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email.value.trim())) {
      setFieldError(form.email, 'The e-mail address format is invalid.'); ok = false;
    }
    if (form.telefon.value.trim() && !/^[0-9+()\s/-]{6,}$/.test(form.telefon.value.trim())) {
      setFieldError(form.telefon, 'The phone number format is invalid.'); ok = false;
    } else {
      clearFieldError(form.telefon);
    }
    if (!form.gdpr.checked) {
      const box = form.gdpr.closest('label')!;
      if (!box.querySelector('.field-error')) {
        const err = document.createElement('p');
        err.className = 'field-error text-xs text-red-400 mt-1';
        err.textContent = 'Consent is required for us to contact you.';
        box.appendChild(err);
      }
      ok = false;
    } else {
      const e = form.gdpr.closest('label')!.querySelector('.field-error');
      if (e) e.remove();
    }
    return ok;
  }

  // Extra fields (sites, units, calculated price) are packed into the description,
  // so the existing Apps Script works without modification.
  function composedLeiras() {
    const parts = [
      '[Energy inspection — heating system above 70 kW] (EN)',
      'Number of sites: ' + (form.telephelyek.value || '1'),
      'Number of heat-generating units: ' + (form.berendezesek.value || '1'),
    ];
    if (lastCalc) parts.push(lastCalc);
    parts.push('', form.leiras.value.trim());
    return parts.join('\n');
  }

  function fieldData() {
    return {
      nev: form.nev.value.trim(),
      ceg: form.ceg.value.trim(),
      email: form.email.value.trim(),
      telefon: form.telefon.value.trim(),
      leiras: composedLeiras(),
      alapok: '',
      linkek: '',
      website: (form.querySelector('input[name="website"]') as HTMLInputElement)?.value || '',
      t: String(Math.round((Date.now() - formRenderedAt) / 1000)),
    };
  }

  function sendMailto() {
    const subject = encodeURIComponent('Energy inspection quote request – ' + (form.ceg.value.trim() || form.nev.value.trim()));
    const body = encodeURIComponent(
      ['Name: ' + form.nev.value.trim(), 'Company: ' + (form.ceg.value.trim() || '—'),
       'E-mail: ' + form.email.value.trim(), 'Phone: ' + (form.telefon.value.trim() || '—'),
       '', composedLeiras()].join('\n')
    );
    window.location.href = 'mailto:hello@bimline.hu?subject=' + subject + '&body=' + body;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;
    track('energetikai_form_submit');

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const orig = btn.textContent;

    if (FORM_ENDPOINT) {
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const params = new URLSearchParams(fieldData() as Record<string, string>);
        await fetch(FORM_ENDPOINT, { method: 'POST', mode: 'no-cors', body: params });
        btn.textContent = 'Thank you! We will be in touch shortly.';
        btn.classList.add('bg-belimo');
        form.reset();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = orig;
        sendMailto();
      }
      return;
    }
    sendMailto();
    btn.textContent = 'E-mail client opened — thank you!';
    btn.classList.add('bg-belimo');
  });

  form?.querySelectorAll('input, textarea, select').forEach((el) => {
    el.addEventListener('input', () => clearFieldError(el as HTMLElement));
  });
</script>
